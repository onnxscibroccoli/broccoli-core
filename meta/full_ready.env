# --- Disk gate (wait until OK before offload / wire) ---
MAX_USED_PCT=92
MIN_FREE_KB=1048576
POLL_SEC=30
MAX_WAIT_SEC=7200

# --- Offload (redundant copies → Drive, then delete local) ---
KEEP_NEWEST_VERSIONS=2
ARCHIVE_LOGS_OVER_MB=50
DELETE_AFTER_UPLOAD=0
RCLONE_REMOTE=gdrive:Broccoli/offload
# If no rclone: set DRIVE_COPY_ROOT after termux-setup-storage, e.g.:
# DRIVE_COPY_ROOT=/storage/emulated/0/Google Drive/Broccoli/offload

# --- Agent / wire ---
RUN_REINIT=0
WIRE_AFTER_PUSH=1
DELIVER_MAC=0
RUN_DISK_CLEAN=1
USER_CONFIRMED_DELETE=0
