selected="false" bounds="[32,1227][1048,1357]" /><node index="1" text="Paste only this block (one shot):" resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,1391][541,1431]" /><node index="2" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,1465][1048,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[64,1445][1016,1551]"><node index="0" text="BASH" resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[64,1494][130,1523]" /><node index="1" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[859,1445][1016,1551]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[859,1445][1016,1551]"><node index="0" text="Copy" resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[933,1493][995,1523]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[859,1476][1016,1540]" /></node></node></node><node index="1" text="" resource-id="" class="android.widget.HorizontalScrollView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[32,1551][1048,2408]"><node index="0" text='python3 &lt;&lt; &apos;FIX&apos;&#10;from pathlib import Path&#10;import os, re&#10;H = Path.home()&#10;ROOT = H / "broccoli"&#10;ROOT.mkdir(parents=True, exist_ok=True)&#10;for d in ("inbox/grok","inbox/gemini","done","fail","runs","reports"):&#10;    (ROOT/d).mkdir(parents=True, exist_ok=True)&#10;&#10;(H/"broccoli_report.py").write_text(r&apos;&apos;&apos;#!/usr/bin/env python3&#10;import sys, subprocess, time&#10;from pathlib import Path&#10;ROOT = Path.home() / "broccoli"&#10;def clip(t):&#10;    try: subprocess.run(["termux-clipboard-set"], input=t.encode(), timeout=8, check=False)&#10;    except Exception: pass&#10;def finish(provider, job, status, reply="", extra=""):&#10;    ts = time.strftime("%Y-%m-%d %H:%M:%S")&#10;    body = "\n".join(["=== BROCCOLI REPORT ===","time: "+ts,"provider: "+provider,&#10;        "job: "+job,"status: "+status,"reply: "+(reply or "")[:2000],&#10;        "extra: "+(extra or "")[:800],"log: ~/broccoli/daemon.log","=== END REPORT ==="])&#10;    (ROOT/"reports/latest.txt").write_text(body)&#10;    (ROOT/"LAST_RUN.txt").write_text("%s %s %s\n"%(provider,status,job))&#10;    print(body, flush=True); clip(body)&#10;    subprocess.run(["termux-toast","-s","Broccoli %s %s"%(status,job[:35])], timeout=5, check=False)&#10;    if status in ("OK","PASS"):&#10;        subprocess.run(["termux-vibrate","-d","400"], timeout=5, check=False)&#10;if __name__=="__main__":&#10;    finish(sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4] if len(sys.argv)&gt;4 else "")&#10;&apos;&apos;&apos;)&#10;(H/"broccoli_report.py").chmod(0o755)&#10;&#10;(H/"broccoli_worker.sh").write_text(r&apos;&apos;&apos;#!/data/data/com.termux/files/usr/bin/bash&#10;ROOT="$HOME/broccoli"&#10;GROK="$HOME/broccoli_bootstrap.py"&#10;GAI="$HOME/google_ai_bootstrap.py"&#10;REP="$HOME/broccoli_report.py"&#10;LOG="$ROOT/worker.log"&#10;mkdir -p "$ROOT"/inbox/grok "$ROOT"/inbox/gemini "$ROOT"/{done,fail,runs,reports}&#10;shopt -s nullglob&#10;echo "=== worker $(date) ===" | tee -a "$LOG"&#10;termux-toast -s "Broccoli: worker pass" 2&gt;/dev/null || true&#10;for job in "$ROOT/inbox/grok"/*.txt; do&#10;  n=$(basename "$job")&#10;  termux-toast -s "Grok: $n" 2&gt;/dev/null || true&#10;  echo "--- grok $n ---" | tee -a "$LOG"&#10;  if out=$(python3 "$GROK" grok-ask "$(cat "$job")" 2&gt;&amp;1 | tee -a "$LOG"); then&#10;    mv "$job" "$ROOT/done/grok_$n"&#10;    python3 "$REP" grok "$n" OK "$out" 2&gt;/dev/null || true&#10;  else&#10;    mv "$job" "$ROOT/fail/$n"&#10;    python3 "$REP" grok "$n" FAIL "$out" 2&gt;/dev/null || true&#10;  fi&#10;done&#10;if [ -f "$GAI" ]; then&#10;  for job in "$ROOT/inbox/gemini"/*.txt; do&#10;    n=$(basename "$job")&#10;    termux-toast -s "Google AI: $n" 2&gt;/dev/null || true&#10;    echo "--- google $n ---" | tee -a "$LOG"&#10;    if out=$(python3 "$GAI" google-ai-ask "$(cat "$job")" 2&gt;&amp;1 | tee -a "$LOG"); then&#10;      mv "$job" "$ROOT/done/gemini_$n"&#10;      python3 "$REP" google "$n" OK "$out" 2&gt;/dev/null || true&#10;    else&#10;      mv "$job" "$ROOT/fail/$n"&#10;      python3 "$REP" google "$n" FAIL "$out" 2&gt;/dev/null || true&#10;    fi&#10;  done&#10;fi&#10;termux-toast -s "Broccoli: idle" 2&gt;/dev/null || true&#10;echo "=== idle $(date) ===" | tee -a "$LOG"&#10;&apos;&apos;&apos;)&#10;(H/"broccoli_worker.sh").chmod(0o755)&#10;&#10;(H/"broccoli-daemon.sh").write_text(r&apos;&apos;&apos;#!/data/data/com.termux/files/usr/bin/bash&#10;ROOT="$HOME/broccoli"&#10;echo $$ &gt; "$ROOT/daemon.pid"&#10;termux-toast -s "Broccoli daemon ON" 2&gt;/dev/null || true&#10;echo "daemon $$ $(date)" &gt;&gt; "$ROOT/daemon.log"&#10;while true; do&#10;  "$HOME/broccoli_worker.sh" &gt;&gt; "$ROOT/daemon.log" 2&gt;&amp;1&#10;  sleep "${BROCCOLI_POLL:-15}"&#10;done&#10;&apos;&apos;&apos;)&#10;(H/"broccoli-daemon.sh").chmod(0o755)&#10;&#10;(H/"brocc").write_text(r&apos;&apos;&apos;#!/data/data/com.termux/files/usr/bin/bash&#10;ROOT="$HOME/broccoli"&#10;case "${1:-}" in&#10;start)&#10;  if [ -f "$ROOT/daemon.pid" ] &amp;&amp; kill -0 "$(cat "$ROOT/daemon.pid")" 2&gt;/dev/null; then&#10;    echo "RUNNING pid $(cat "$ROOT/daemon.pid")"; exit 0&#10;  fi&#10;  nohup "$HOME/broccoli-daemon.sh" &gt;&gt; "$ROOT/daemon.log" 2&gt;&amp;1 &amp;&#10;  echo "started $!"; termux-toast -s "Broccoli started" 2&gt;/dev/null || true ;;&#10;stop)&#10;  [ -f "$ROOT/daemon.pid" ] &amp;&amp; kill "$(cat "$ROOT/daemon.pid")" 2&gt;/dev/null; rm -f "$ROOT/daemon.pid"&#10;  termux-toast -s "Broccoli stopped" 2&gt;/dev/null || true ;;&#10;status)&#10;  if [ -f "$ROOT/daemon.pid" ] &amp;&amp; kill -0 "$(cat "$ROOT/daemon.pid")" 2&gt;/dev/null; then echo RUNNING "$(cat "$ROOT/daemon.pid")"; else echo STOPPED; fi&#10;  echo "inbox grok:"; ls "$ROOT/inbox/grok" 2&gt;/dev/null; echo "inbox gemini:"; ls "$ROOT/inbox/gemini" 2&gt;/dev/null&#10;  cat "$ROOT/LAST_RUN.txt" 2&gt;/dev/null ;;&#10;log) tail -n "${2:-50}" "$ROOT/daemon.log" ;;&#10;report) cat "$ROOT/reports/latest.txt" 2&gt;/dev/null; termux-clipboard-set &lt; "$ROOT/reports/latest.txt" 2&gt;/dev/null; termux-toast -s "Report copied" 2&gt;/dev/null || true ;;&#10;ask)&#10;  p="${2:-grok}"; shift 2; f="$ROOT/inbox/$p/$(date +%s).txt"; printf &apos;%s\n&apos; "$*" &gt; "$f"&#10;  echo "queued $f"; termux-toast -s "Queued $p" 2&gt;/dev/null || true ;;&#10;run-once) "$HOME/broccoli_worker.sh" ;;&#10;*) echo "brocc start|stop|status|log|report|ask grok|gemini TEXT|run-once" ;;&#10;esac&#10;&apos;&apos;&apos;)&#10;(H/"brocc").chmod(0o755)&#10;&#10;bp = H/"broccoli_bootstrap.py"&#10;if bp.is_file():&#10;    s = bp.read_text()&#10;    s = s.replace("def rish_cat_to_file(remote_path, local_path, t=120):",&#10;                  "def rish_cat_to_file(remote_path, local_path, t=35):")&#10;    s = re.sub(r"def clear_composer\(\):.*?(?=\ndef )", "def clear_composer():\n    pass\n\n", s, count=1, flags=re.S)&#10;    s = s.replace("clipboard_set(text)\n    try:\n        clear_composer()\n    except NameError:\n        pass\n    paste()", "clipboard_set(text)\n    paste()")&#10;    s = s.replace("    clear_composer()\n    paste()", "    paste()")&#10;    if &apos;termux-toast","-s","Broccoli: Grok start"&apos; not in s:&#10;        s = s.replace(&apos;    log("grok_ask composer&apos;, &apos;    subprocess.run(["termux-toast","-s","Broccoli: Grok start"],timeout=4,check=False)\n    log("grok_ask composer&apos;, 1)&#10;    bp.write_text(s)&#10;&#10;(ROOT/"PROJECT.md").write_text("# Broccoli\nbrocc ask grok &apos;task&apos;\nbrocc start\nbrocc log 60\nbrocc report\n")&#10;print("FIX OK — use: brocc")&#10;FIX&#10;&#10;export PATH="$HOME:$PATH"&#10;python3 -m py_compile ~/broccoli_bootstrap.py &amp;&amp; echo GROK_OK&#10;brocc stop 2&gt;/dev/null; brocc start&#10;brocc status' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,1576][1048,2408]" /></node></node></node></node><node ind