00) or "(none)",\n        "If not (n&#10;one): obey user over auto-iterate; reply USER_ACK: &lt;line&gt;."&#10;,\n        "",\n        &apos;"=== THIS JOB ===",&apos;,&#10;&gt;     )&#10;&gt;     if "ROOT = Path.home()" in cs and &apos;ROOT / "user"&apos; not&#10; in cs:&#10;&gt;         pass&#10;&gt; cp.write_text(cs)&#10;&gt;&#10;&gt; # brocc inject&#10;&gt; br = H / "brocc"&#10;&gt; if br.is_file() and "inject)" not in br.read_text():&#10;&gt;     t = br.read_text()&#10;&gt;     t = t.replace(&#10;&gt;         "run-once)",&#10;&gt;         &apos;&apos;&apos;inject)&#10;&gt;   shift&#10;&gt;   echo "$*" &gt; "$ROOT/user/PENDING.md"&#10;&gt;   echo "user re-entry queued"&#10;&gt;   termux-toast -s "Broccoli: user inject" 2&gt;/dev/null || &#10;true ;;&#10;&gt; pause)&#10;&gt;   python3 -c "import json;from pathlib import Path;p=Path&#10;.home()/&apos;broccoli/tasks/state.json&apos;;d=json.loads(p.read_tex&#10;t()) if p.is_file() else {};d[&apos;status&apos;]=&apos;PAUSED&apos;;p.parent.m&#10;kdir(parents=True,exist_ok=True);p.write_text(json.dumps(d,&#10;indent=2))" 2&gt;/dev/null&#10;&gt;   termux-toast -s "Broccoli: PAUSED" 2&gt;/dev/null || true &#10;;;&#10;&gt; resume)&#10;&gt;   python3 -c "import json;from pathlib import Path;p=Path&#10;.home()/&apos;broccoli/tasks/state.json&apos;;d=json.loads(p.read_tex&#10;t()) if p.is_file() else {};d[&apos;status&apos;]=&apos;RUNNING&apos;;p.write_t&#10;ext(json.dumps(d,indent=2))" 2&gt;/dev/null&#10;&gt;   termux-toast -s "Broccoli: RUNNING" 2&gt;/dev/null || true&#10; ;;&#10;&gt; run-once)&apos;&apos;&apos;,&#10;&gt;     )&#10;&gt;     t = t.replace("ask grok|gemini", "ask grok|gemini|inj&#10;ect|pause|resume")&#10;&gt;     br.write_text(t)&#10;&gt;&#10;&gt; print("UX OK")&#10;&gt; UX&#10;  File "&lt;stdin&gt;", line 59&#10;    &apos;"=== USER RE-ENTRY ===",\n        read(ROOT / "user" /&#10; "PENDING.md", 1500) or "(none)",\n        "If not (none): &#10;obey user over auto-iterate; reply USER_ACK: &lt;line&gt;.",\n   &#10;     "",\n        &apos;"=== THIS JOB ===",&apos;,&#10;                                                           &#10;                                                           &#10;                                                           &#10;                                      ^&#10;SyntaxError: unterminated string literal (detected at line &#10;59)&#10;~ $&#10;~ $ python3 -m py_compile ~/broccoli_bootstrap.py 2&gt;/dev/nu&#10;ll &amp;&amp; echo COMPILE_OK&#10;COMPILE_OK&#10;~ $' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[174,0][1004,985]" /></node><node index="1" text="" resource-id="" class="android.widget.CheckBox" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[134,0][1048,1123]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,1406][1048,2408]"><node index="0" text="NEXT_STEP: Install missing broccoli_accept.py (PATCH died on quote syntax), seed ~/.grok_ui_cal.json (send was null), treat empty reply as FAIL with scroll + longer wait, and extend ~/brocc with task / inject / pause / resume." resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,1406][1048,1471]" /><node index="1" text="TERMINUX (paste