&gt; # --- report helper (clipboard + file + stdout) ---&#10;&gt; (H / "broccoli_report.py").write_text(r&apos;&apos;&apos;#!/usr/bin/env &#10;python3&#10;&gt; import os, sys, subprocess, time&#10;&gt; from pathlib import Path&#10;&gt; ROOT = Path.home() / "broccoli"&#10;&gt; def clip(text):&#10;&gt;     try:&#10;&gt;         subprocess.run(["termux-clipboard-set"], input=te&#10;xt.encode("utf-8"), timeout=8, check=False)&#10;&gt;     except Exception:&#10;&gt;         pass&#10;&gt; def announce(msg):&#10;&gt;     print(msg, flush=True)&#10;&gt;     try:&#10;&gt;         subprocess.run(["termux-toast", "-s", msg[:90]], &#10;timeout=5, check=False)&#10;&gt;     except Exception:&#10;&gt;         pass&#10;&gt; def finish(provider, job, status, reply="", extra=""):&#10;&gt;     ts = time.strftime("%Y-%m-%d %H:%M:%S")&#10;&gt;     body = "\n".join([&#10;&gt;         "=== BROCCOLI REPORT ===",&#10;&gt;         "time: %s" % ts,&#10;&gt;         "provider: %s" % provider,&#10;&gt;         "job: %s" % job,&#10;ev/null || true&#10;    fi&#10;  done&#10;fi&#10;termux-toast -s "Broccoli: idle" 2&gt;/dev/null || true&#10;echo "=== idle $(date) ===" | tee -a "$LOG"&#10;&apos;&apos;&apos;)&#10;(H / "broccoli_worker.sh").chmod(0o755)&#10;&#10;# --- daemon loop (background service) ---&#10;(H / "broccoli-daemon.sh").writ&gt;         "status: %s" % sta&#10;tus,&#10;&gt;         "reply: %s" % ((reply or "")[:2000]),&#10;&gt;         "extra: %s" % (extra or "")[:800],&#10;&gt;         "paths: ~/broccoli/daemon.log ~/broccoli/worker.l&#10;og",&#10;&gt;         "=== END REPORT ===",&#10;&gt;     ])&#10;&gt;     p = ROOT / "reports" / "latest.txt"&#10;mon ON" 2&gt;/dev/null || true&#10;echo "daemon&gt;     p.write_text(body)&#10;&gt;     (ROOT / "LAST_RUN.txt").write_text("%s %s %s\n" % (pr&#10;ovider, status, job))&#10;$INTE&gt;     print(body, flush=True)&#10;&gt;     clip(body)&#10;&gt;     if status in ("OK", "PASS"):&#10;&gt;         try: subprocess.run(["termux-vibrate", "-d", "400&#10;"], timeout=5, check=False)&#10;&gt;         except Exception: pass&#10;&gt;     announce("Broccoli %s %s" % (status, job[:40]))&#10;&gt; if __name__ == "__main__":&#10;&gt;     # broccoli_report.py grok jobname OK "reply text" "op&#10;tional"&#10;&gt;     finish(sys.argv[1], sys.argv[2], sys.argv[3], sys.arg&#10;v[4] if len(sys.argv)&gt;4 else "", sys.argv[5] if len(sys.arg&#10;v)&gt;5 else "")&#10;&gt; &apos;&apos;&apos;)&#10;&gt; (H / "broccoli_report.py").chmod(0o755)&#10;&gt;&#10;&gt; # --- patch grok driver: fast cat timeout + announce + re&#10;port hook ---&#10;&gt; bp = H / "broccoli_bootstrap.py"&#10;&gt; if bp.is_file():&#10;&gt;     s = bp.read_text()&#10;&gt;     s = s.replace("timeout=t)", "timeout=min(t,45))", 1) &#10;if "rish_cat_to_file" in s else s&#10;&gt;     s = s.replace("def rish_cat_to_file(remote_path, loca&#10;l_path, t=120):",&#10;&gt;                   "def rish_cat_to_file(remote_path, loca&#10;l_path, t=35):")&#10;&gt;     if "BROCCOLI_ANNOUNCE_START" not in s:&#10;&gt;         s = s.replace(&#10;&gt;             &apos;def grok_ask(text, wait=50&apos;,&#10;&gt;             &apos;def grok_ask(text, wait=50, job_name="grok-a&#10;sk"&apos;,&#10;&gt;         )&#10;&gt;         inj = &apos;&apos;&apos;&#10;&gt;     try:&#10;&gt;         subprocess.run(["termux-toast","-s","Broccoli: Gr&#10;ok start"],timeout=4,check=False)&#10;&gt;     except Exception:&#10;&gt;         pass&#10;&gt; &apos;&apos;&apos;&#10;" &gt; &gt;         if "grok_ask composer" not in s or inj.strip(&#10;) not in s:&#10;&gt;             s = s.replace(&apos;    log("grok_ask composer&apos;, i&#10;nj + &apos;    log("grok_ask composer&apos;, 1)&#10;&gt;     if "broccoli_report.py" not in s and "def main():" in&#10; s:&#10;&gt;         s = s.replace(&#10;&gt;             &apos;        broccoli_done("grok", "OK", reply)&apos;,&#10;&gt;             &apos;        broccoli_done("grok", "OK", reply)\n&#10;        subprocess.run([sys.executable, os.path.expanduser(&#10;"~/broccoli_report.py"), "grok", "grok-ask", "OK", reply or&#10; ""], check=False)&apos;,&#10;&gt;         )&#10;rt&#10;- Phone&gt;     s = s.replace("clear_composer()\n    paste()",&#10; "paste()")&#10;&gt;     s = s.replace("    clear_composer()\n    paste()", " &#10;   paste()")&#10;&gt;     import re&#10;&gt;     s = re.sub(r"def clear_composer\(\):.*?(?=\ndef )", "&#10;def clear_composer():\n    pass\n\n", s, count=1, flags=re.&#10;S)&#10;&gt;     bp.write_text(s)&#10;&gt;&#10;&gt; # --- worker (one pass, logs, report on fail) ---&#10;&gt; (H / "broccoli_worker.sh").write_text(r&apos;&apos;&apos;#!/data/data/co&#10;m.termux/files/usr/bin/bash&#10;&gt; ROOT="$HOME/broccoli"&#10;&gt; GROK="$HOME/broccoli_bootstrap.py"&#10;&gt; GAI="$HOME/google_ai_bootstrap.py"&#10;&gt; REPORT="$HOME/broccoli_report.py"&#10;&gt; LOG="$ROOT/worker.log"&#10;&gt; mkdir -p "$ROOT"/inbox/grok "$ROOT"/inbox/gemini "$ROOT"/&#10;{done,fail,runs,reports}&#10;&gt; shopt -s nullglob&#10;&gt; echo "=== worker pass $(date) ===" | tee -a "$LOG"&#10;&gt; termux-toast -s "Broccoli: worker pass" 2&gt;/dev/null || tr&#10;ue&#10;&gt; for job in "$ROOT/inbox/grok"/*.txt; do&#10;&gt;   name=$(basename "$job")&#10;&gt;   termux-toast -s "Grok: $name" 2&gt;/dev/null || true&#10;&gt;   echo "--- grok $name ---" | tee -a "$LOG"&#10;&gt;   if out=$(python3 "$GROK" grok-ask "$(cat "$job")" 2&gt;&amp;1 &#10;| tee -a "$LOG"); then&#10;&gt;     mv "$job" "$ROOT/done/grok_$name"&#10;&gt;     python3 "$REPORT" grok "$name" OK "$out" 2&gt;/dev/null &#10;|| true&#10;&gt;   else&#10;&gt;     mv "$job" "$ROOT/fail/$name"&#10;&gt;     python3 "$REPORT" grok "$name" FAIL "$out" 2&gt;/dev/nul&#10;l || true&#10;&gt;   fi&#10;&gt; done&#10;&gt; if [ -f "$GAI" ]; then&#10;&gt;   for job in "$ROOT/inbox/gemini"/*.txt; do&#10;&gt;     name=$(basename "$job")&#10;&gt;     termux-toast -s "Google AI: $name" 2&gt;/dev/null || tru&#10;e&#10;&gt;     echo "--- google $name ---" | tee -a "$LOG"&#10;&gt;     if out=$(python3 "$GAI" google-ai-ask "$(cat "$job")"&#10; 2&gt;&amp;1 | tee -a "$LOG"); then&#10;&gt;       mv "$job" "$ROOT/done/gemini_$name"&#10;&gt;       python3 "$REPORT" google "$name" OK "$out" 2&gt;/dev/n&#10;ull || true&#10;&gt;     else&#10;&gt;       mv "$job" "$ROOT/fail/$name"&#10;&gt;       python3 "$REPORT" google "$name" FAIL "$out" 2&gt;/dev&#10;/null || true&#10;&gt;     fi&#10;&gt;   done&#10;&gt; fi&#10;&gt; termux-toast -s "Broccoli: idle" 2&gt;/dev/null || true&#10;&gt; echo "=== idle $(date) ===" | tee -a "$LOG"&#10;&gt; &apos;&apos;&apos;)&#10;&gt; (H / "broccoli_worker.sh").chmod(0o755)&#10;&gt;&#10;&gt; # --- daemon loop (background service) ---&#10;&gt; (H / "broccoli-daemon.sh").write_text(r&apos;&apos;&apos;#!/data/data/co&#10;m.termux/files/usr/bin/bash&#10;&gt; ROOT="$HOME/broccoli"&#10;&gt; PIDF="$ROOT/daemon.pid"&#10;&gt; LOG="$ROOT/daemon.log"&#10;&gt; INTERVAL="${BROCCOLI_POLL:-15}"&#10;&gt; mkdir -p "$ROOT"&#10;&gt; echo $$ &gt; "$PIDF"&#10;&gt; termux-toast -s "Broccoli daemon ON" 2&gt;/dev/null || true&#10;&gt; echo "daemon start $$ $(date)" &gt;&gt; "$LOG"&#10;&gt; while true; do&#10;&gt;   "$HOME/broccoli_worker.sh" &gt;&gt; "$LOG" 2&gt;&amp;1&#10;&gt;   sleep "$INTERVAL"&#10;&gt; done&#10;&gt; &apos;&apos;&apos;)&#10;&gt; (H / "broccoli-daemon.sh").chmod(0o755)&#10;&gt;&#10;&gt; # --- CLI ---&#10;&gt; (H / "broccoli").write_text(r&apos;&apos;&apos;#!/data/data/com.termux/f&#10;iles/usr/bin/bash&#10;&gt; ROOT="$HOME/broccoli"&#10;&gt; case "${1:-}" in&#10;&gt;   start)&#10;&gt;     if [ -f "$ROOT/daemon.pid" ] &amp;&amp; kill -0 "$(cat "$ROOT&#10;/daemon.pid")" 2&gt;/dev/null; then&#10;&gt;       echo "already running pid $(cat "$ROOT/daemon.pid")&#10;"; exit 0&#10;&gt;     fi&#10;&gt;     nohup "$HOME/broccoli-daemon.sh" &gt;&gt; "$ROOT/daemon.log&#10;" 2&gt;&amp;1 &amp;&#10;&gt;     echo "daemon pid $!"; termux-toast -s "Broccoli start&#10;ed" 2&gt;/dev/null || true&#10;&gt;     ;;&#10;&gt;   stop)&#10;&gt;     [ -f "$ROOT/daemon.pid" ] &amp;&amp; kill "$(cat "$ROOT/daemo&#10;n.pid")" 2&gt;/dev/null &amp;&amp; rm -f "$ROOT/daemon.pid"&#10;&gt;     termux-toast -s "Broccoli stopped" 2&gt;/dev/null || tru&#10;e; echo stopped&#10;&gt;     ;;&#10;&gt;   status)&#10;&gt;     if [ -f "$ROOT/daemon.pid" ] &amp;&amp; kill -0 "$(cat "$ROOT&#10;/daemon.pid")" 2&gt;/dev/null; then echo RUNNING pid "$(cat "$&#10;ROOT/daemon.pid")"; else echo STOPPED; fi&#10;&gt;     ls "$ROOT/inbox/grok" "$ROOT/inbox/gemini" 2&gt;/dev/nul&#10;l&#10;&gt;     cat "$ROOT/LAST_RUN.txt" 2&gt;/dev/null&#10;&gt;     ;;&#10;&gt;   log) tail -n "${2:-40}" "$ROOT/daemon.log" ;;&#10;&gt;   report) cat "$ROOT/reports/latest.txt"; termux-toast -s&#10; "Report on clipboard" 2&gt;/dev/null || true ;;&#10;&gt;   ask)&#10;&gt;     p="${2:-grok}"; shift 2 || true&#10;&gt;     f="$ROOT/inbox/$p/$(date +%s)_ask.txt"&#10;&gt;     echo "$*" &gt; "$f"&#10;&gt;     echo "queued $f"&#10;&gt;     termux-toast -s "Queued $p" 2&gt;/dev/null || true&#10;&gt;     ;;&#10;&gt;   run-once) "$HOME/broccoli_worker.sh" ;;&#10;&gt;   *)&#10;&gt;     echo "broccoli start|stop|status|log [n]|report|ask g&#10;rok|gemini TEXT|run-once"&#10;&gt;     ;;&#10;&gt; esac&#10;&gt; &apos;&apos;&apos;)&#10;&gt; (H / "broccoli").chmod(0o755)&#10;&gt;&#10;&gt; # --- project loop seed (iterative, not smoke) ---&#10;&gt; (B / "PROJECT.md").write_text("""# Broccoli project loop&#10;&gt; - Queue: broccoli ask grok &apos;your task&apos;&#10;&gt; - Daemon: broccoli start&#10;&gt; - Log: broccoli log 60&#10;&gt; - Last result (clipboard): broccoli report&#10;&gt; - Phone stays on target app (Grok / Google AI) during job&#10;s.&#10;&gt; """)&#10;&gt;&#10;&gt; (B / "inbox/grok/01_iterate.txt").write_text("""You are b&#10;uilding Broccoli UI automation (Termux+Shizuku).&#10;&gt; Read PROJECT.md goals. This turn:&#10;&gt; 1) NEXT_STEP: one reliability fix&#10;&gt; 2) TERMINUX_BLOCK: one paste-only heredoc&#10;&gt; 3) TEST: one command; expected line in log&#10;&gt; 4) REPORT_FOR_MAC: 5 lines pasteable summary&#10;&gt; Task: reduce dump_ui hang (rish cat timeout); user reques&#10;t driven loop.""")&#10;&gt; print("SETUP OK")&#10;&gt; SETUP&#10;Traceback (most recent call last):&#10;  File "&lt;stdin&gt;", line 144, in &lt;module&gt;&#10;  File "/data/data/com.termux/files/usr/lib/python3.13/path&#10;lib/_local.py", line 555, in write_text&#10;    return PathBase.write_text(self, data, encoding, errors&#10;, newline)&#10;           ~~~~~~~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^&#10;^^^^^^^^^^&#10;  File "/data/data/com.termux/files/usr/lib/python3.13/path&#10;lib/_abc.py", line 651, in write_text&#10;    with self.open(mode=&apos;w&apos;, encoding=encoding, errors=erro&#10;rs, newline=newline) as f:&#10;         ~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^&#10;^^^^^^^^^^^^^^^^^^^^&#10;  File "/data/data/com.termux/files/usr/lib/python3.13/path&#10;lib/_local.py", line 537, in open&#10;    return io.open(self, mode, buffering, encoding, errors,&#10; newline)&#10;           ~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^&#10;^^^^^^^^^&#10;IsADirectoryError: [Errno 21] Is a directory: &apos;/data/data/c&#10;om.termux/files/home/broccoli&apos;&#10;~ $&#10;~ $ python3 -m py_compile ~/broccoli_bootstrap.py 2&gt;/dev/nu&#10;ll; python3 -m py_compile ~/google_ai_bootstrap.py 2&gt;/dev/n&#10;ull&#10;~ $ export PATH="$HOME:$PATH"&#10;~ $ broccoli stop 2&gt;/dev/null; broccoli start&#10;No command broccoli found, did you mean:&#10; Command brotli in package brotli&#10;~ $ echo "--- use: broccoli status; broccoli log 20; brocco&#10;li report ---"&#10;--- use: broccoli status; broccoli log 20; broccoli report &#10;---&#10;~ $&#10;Add explicit error handling to daemon' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,0][1009,1022]" /></node><node i