ons")&#10;&apos;&apos;&apos;&#10;&#10;for p in candidates:&#10;    if p.suffix == ".py":&#10;        t = p.read_text()&#10;        if "BROCC_CAPTURE_RETRY" not in t:&#10;            t = HOOK + t&#10;        if "retry_capture_suggestions" not in t and "junk reply" in t:&#10;            t = t.replace(&#10;                &apos;fail("junk reply")&apos;,&#10;                JUNK_FIX.strip() + &apos;\n    fail("junk reply")&apos;,&#10;                1,&#10;            )&#10;            t = t.replace(&#10;                &apos;"junk reply"&apos;,&#10;                &apos;"retry_capture_suggestions" if looks_like_suggestions_only(str(reply or "")) else "junk reply"&apos;,&#10;                1,&#10;            )&#10;        p.write_text(t)&#10;        print("patched", p)&#10;&#10;# Worker: prefer google when TASK provider google and grok not required&#10;wp = ROOT / "broccoli_worker.sh"&#10;if not wp.exists():&#10;    wp = HOME / "broccoli_worker.sh"&#10;if wp.exists():&#10;    wt = wp.read_text()&#10;    if "BROCC_GOOGLE_FIRST" not in wt:&#10;        snippet = &apos;&apos;&apos;&#10;# BROCC_GOOGLE_FIRST&#10;if [ -f "$HOME/broccoli/tasks/current/TASK.md" ] &amp;&amp; grep -q &apos;^provider: google&apos; "$HOME/broccoli/tasks/current/TASK.md" 2&gt;/dev/null; then&#10;  brocc research round 2&gt;/dev/null || python3 "$HOME/broccoli_research.py" round 2&gt;/dev/null || true&#10;fi&#10;&apos;&apos;&apos;&#10;        wp.write_text(snippet + wt)&#10;        print("patched", wp)&#10;&#10;print("capture_retry installed")&#10;END&#10;brocc recover&#10;brocc resume 2&gt;/dev/null || true&#10;brocc smoke --force&#10;brocc research round 2&gt;/dev/null || python3 ~/broccoli_research.py round 2&gt;/dev/null || true&#10;brocc run-once&#10;brocc report' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password=