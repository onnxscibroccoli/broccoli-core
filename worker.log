d "LOOP_OK" not in t:&#10;    sys.exit(1)&#10;# task mode: require LOOP_OK unless env SMOKE=1&#10;if os.environ.get("BROCCOLI_SMOKE") != "1":&#10;    if not re.search(r"(^|\n)LOOP_OK(\s|$)", t) and "LOOP_OK" not in t.split()[0:3]:&#10;        if "TASK_COMPLETE:" not in t and "NEXT_STEP:" not in t[:200]:&#10;            sys.exit(1)&#10;print(t)&#10;&apos;&apos;&apos;)&#10;os.chmod(H / "broccoli_reply_ok.py", 0o755)&#10;&#10;cp = H / "broccoli_compose.py"&#10;if cp.is_file():&#10;    t = cp.read_text()&#10;    if "OUTPUT CONTRACT" not in t:&#10;        t = t.replace(&#10;            &apos;"=== THIS JOB ===",&apos;,&#10;            &apos;"=== OUTPUT CONTRACT ===",\n&apos;&#10;            &apos;        "First line of assistant reply MUST be exactly: LOOP_OK",\n&apos;&#10;            &apos;        "Then NEXT_STEP: one line. Then TERMINUX/TEST/REPORT_FOR_MAC as needed.",\n&apos;&#10;            &apos;        "",\n&apos;&#10;            &apos;        "=== THIS JOB ===",&apos;,&#10;            1,&#10;        )&#10;        cp.write_text(t)&#10;&#10;(R / "thread" / "conversation.md").write_text("# Broccoli thread\n\n")&#10;(R / "inbox" / "grok").mkdir(parents=True, exist_ok=True)&#10;(R / "inbox" / "grok" / "loop_ok_only.txt").write_text(&#10;    "OUTPUT CONTRACT: line 1 must be LOOP_OK only.\n"&#10;    "Then NEXT_STEP: one line.\n"&#10;    "Then REPORT_FOR_MAC: 4 short lines.\n"&#10;    "No BROCCOLI CONTEXT. No quoting user prompt.\n"&#10;)&#10;&#10;print("END OK")&#10;END&#10;&#10;python3 -m py_compile ~/broccoli_bootstrap.py ~/broccoli_reply_ok.py &amp;&amp; echo COMPILE_OK&#10;brocc meta-heal&#10;brocc recover&#10;brocc smoke&#10;brocc run-once&#10;brocc report&#10;python3 ~/broccoli_accept.py || true' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,17