= Path.home()&#10;&gt; ROOT = H / "broccoli"&#10;vider,&#10;        "job: "+&gt; ROOT.mkdir(parents=True, exist_ok=True)&#10;&gt; for d in ("inbox/grok","inbox/gemini","done","fail","runs&#10;","reports"):&#10;&gt;     (ROOT/d).mkdir(parents=True, exist_ok=True)&#10;&gt;&#10;&gt; (H/"broccoli_report.py").write_text(r&apos;&apos;&apos;#!/usr/bin/env py&#10;thon3&#10;&gt; import sys, subprocess, time&#10;&gt; from pathlib import Path&#10;&gt; ROOT = Path.home() / "broccoli"&#10;&gt; def clip(t):&#10;&gt;     try: subprocess.run(["termux-clipboard-set"], input=t&#10;.encode(), timeout=8, check=False)&#10;&gt;     except Exception: pass&#10;&gt; def finish(provider, job, status, reply="", extra=""):&#10;&gt;     ts = time.strftime("%Y-%m-%d %H:%M:%S")&#10;&gt;     body = "\n".join(["=== BROCCOLI REPORT ===","time: "+&#10;ts,"provider: "+provider,&#10;&gt;         "job: "+job,"status: "+status,"reply: "+(reply or&#10; "")[:2000],&#10;&gt;         "extra: "+(extra or "")[:800],"log: ~/broccoli/da&#10;emon.log","=== END REPORT ==="])&#10;&gt;     (ROOT/"reports/latest.txt").write_text(body)&#10;&gt;     (ROOT/"LAST_RUN.txt").write_text("%s %s %s\n"%(provid&#10;er,status,job))&#10;&gt;     print(body, flush=True); clip(body)&#10;&gt;     subprocess.run(["termux-toast","-s","Broccoli %s %s"%&#10;(status,job[:35])], timeout=5, check=False)&#10;&gt;     if status in ("OK","PASS"):&#10;&gt;         subprocess.run(["termux-vibrate","-d","400"], tim&#10;eout=5, check=False)&#10;&gt; if __name__=="__main__":&#10;&gt;     finish(sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4&#10;] if len(sys.argv)&gt;4 else "")&#10;&gt; &apos;&apos;&apos;)&#10;&gt; (H/"broccoli_report.py").chmod(0o755)&#10;&gt;&#10;&gt; (H/"broccoli_worker.sh").write_text(r&apos;&apos;&apos;#!/data/data/com.&#10;termux/files/usr/bin/bash&#10;&gt; ROOT="$HOME/broccoli"&#10;&gt; GROK="$HOME/broccoli_bootstrap.py"&#10;&gt; GAI="$HOME/google_ai_bootstrap.py"&#10;&gt; REP="$HOME/broccoli_report.py"&#10;&gt; LOG="$ROOT/worker.log"&#10;&gt; mkdir -p "$ROOT"/inbox/grok "$ROOT"/inbox/gemini "$ROOT"/&#10;{done,fail,runs,reports}&#10;&gt; shopt -s nullglob&#10;&gt; echo "=== worker $(date) ===" | tee -a "$LOG"&#10&#10;&gt;         "- Output for automation:",&#10;&gt;         "  NEXT_STEP: (one line)",&#10;&gt;         "  TERMINUX: (one paste-only heredoc block, no ma&#10;rkdown fences)",&#10;&gt;         "  TEST: (one command + expected PASS line)",&#10;&gt;         "  REPORT_FOR_MAC: (max 8 lines, pasteable; no XM&#10;L dumps)",&#10;&gt;         "",&#10;&gt;         "=== THIS JOB ===",&#10;&gt;         job,&#10;&gt;     ])&#10;&gt;     sys.stdout.write(prompt)&#10;&gt;&#10;&gt; if __name__ == "__main__":&#10;&gt;     main()&#10;&gt; &apos;&apos;&apos;)&#10;&gt; (H / "broccoli_compose.py").chmod(0o755)&#10;&gt;&#10;&gt; # --- append thread after each successful grok job ---&#10;&gt; append_py = r&apos;&apos;&apos;&#10;&gt; import sys&#10;&gt; from pathlib import Path&#10;&gt; import time&#10;MP&gt; ROOT = Path.home() / "broccoli"&#10;&gt; THREAD = ROOT / "thread" / "conversation.md"&#10;&gt; THREAD.parent.mkdir(parents=True, exist_ok=True)&#10;&gt; job, reply = sys.argv[1], sys.argv[2] if len(sys.argv)&gt;2 &#10;else ""&#10;&gt; block = "\n\n## %s\n**job:** %s\n**grok:**\n%s\n" % (time&#10;.strftime("%Y-%m-%d %H:%M"), job, (reply or "")[:3500])&#10;&gt; with open(THREAD, "a") as f:&#10;&gt;     f.write(block)&#10;&gt; &apos;&apos;&apos;&#10;&gt; (H / "broccoli_thread_append.py").write_text("#!/usr/bin/&#10;env python3\n" + append_py)&#10;&gt; (H / "broccoli_thread_append.py").chmod(0o755)&#10;&gt;&#10;&gt; # --- grok driver: log -&gt; stderr, only reply on stdout --&#10;-&#10;&gt; bp = H / "broccoli_bootstrap.py"&#10;&gt; if bp.is_file():&#10;&gt;     s = bp.read_text()&#10;&gt;     if "def log(*a):" in s and "file=sys.stderr" not in s&#10;.split("def log")[1][:200]:&#10;&gt;         s = s.replace(&#10;&gt;             "def log(*a):\n    print(*a, flush=True)",&#10;&gt;             "def log(*a):\n    import sys\n    print(*a, &#10;flush=True, file=sys.stderr)",&#10;&gt;         )&#10;&gt;         s = s.replace(&#10;&gt;             &apos;def log(*a):\n    print(*a, flush=True)\n&apos;,&#10;&gt;             &apos;def log(*a):\n    import sys\n    print(*a, &#10;flush=True, file=sys.stderr)\n&apos;,&#10;&gt;         )&#10;&gt;     s = re.sub(r"def clear_composer\(\):.*?(?=\ndef )", "&#10;def clear_composer():\n    pass\n\n", s, count=1, flags=re.&#10;S)&#10;&gt;     s = s.replace("clipboard_set(text)\n    try:\n       &#10; clear_composer()\n    except NameError:\n        pass\n   &#10; paste()", "clipboard_set(text)\n    paste()")&#10;&gt;     s = s.replace("    clear_composer()\n    paste()", " &#10;   paste()")&#10;&gt;     # grok-ask: final answer only on stdout&#10;&gt;     if "print(reply)" not in s or &apos;file=sys.stderr&apos; in s:&#10;&gt;         pass&#10;&gt;     s = re.sub(&#10;&gt;         r&apos;(if a == "grok-ask":.*?reply = grok_ask\(prompt&#10;\).*?)(\n        run_id|\n        json\.dump|\n        log\&#10;("WROTE")&apos;,&#10;&gt;         r&apos;\1\n        print(reply or "", flush=True)\2&apos;,&#10;&gt;         s, count=1, flags=re.S,&#10;&gt;     )&#10;&gt;     bp.write_text(s)&#10;&gt;&#10;&gt; # --- worker: compose prompt, stderr=log, stdout=reply --&#10;-&#10;&gt; (H / "broccoli_worker.sh").write_text(r&apos;&apos;&apos;#!/data/data/co&#10;m.termux/files/usr/bin/bash&#10;&gt; ROOT="$HOME/broccoli"&#10;&gt; GROK="$HOME/broccoli_bootstrap.py"&#10;&gt; GAI="$HOME/google_ai_bootstrap.py"&#10;&gt; COMPOSE="$HOME/broccoli_compose.py"&#10;&gt; REP="$HOME/broccoli_report.py"&#10;&gt; THREAD="$HOME/broccoli_thread_append.py"&#10;&gt; LOG="$ROOT/worker.log"&#10;&gt; mkdir -p "$ROOT"/inbox/grok "$ROOT"/inbox/gemini "$ROOT"/&#10;{done,fail,runs,reports,thread}&#10;&gt; shopt -s nullglob&#10;&gt; echo "=== worker $(date) ===" | tee -a "$LOG"&#10;&gt; termux-toast -s "Broccoli: worker pass" 2&gt;/dev/null || tr&#10;ue&#10;&gt; for job in "$ROOT/inbox/grok"/*.txt; do&#10;&gt;   n=$(basename "$job")&#10;&gt;   termux-toast -s "Grok: $n" 2&gt;/dev/null || true&#10;&gt;   echo "--- grok $n ---" | tee -a "$LOG"&#10;&gt;   prompt=$(python3 "$COMPOSE" "$job")&#10;&gt;   if reply=$(python3 "$GROK" grok-ask "$prompt" 2&gt;&gt;"$LOG"&#10;); then&#10;&gt;     echo "$reply" | tee -a "$LOG"&#10;&gt;     mv "$job" "$ROOT/done/grok_$n"&#10;&gt;     python3 "$THREAD" "$n" "$reply" 2&gt;/dev/null || true&#10;&gt;     python3 "$REP" grok "$n" OK "$reply" 2&gt;/dev/null || t&#10;rue&#10;&gt;   else&#10;&gt;     err=$(tail -30 "$LOG")&#10;&gt;     mv "$job" "$ROOT/fail/$n"&#10;&gt;     python3 "$REP" grok "$n" FAIL "$err" 2&gt;/dev/null || t&#10;rue&#10;&gt;   fi&#10;&gt; done&#10;&gt; if [ -f "$GAI" ]; then&#10;&gt;   for job in "$ROOT/inbox/gemini"/*.txt; do&#10;&gt;     n=$(basename "$job")&#10;&gt;     termux-toast -s "Google AI: $n" 2&gt;/dev/null || true&#10;&gt;     echo "--- google $n ---" | tee -a "$LOG"&#10;&gt;     if reply=$(python3 "$GAI" google-ai-ask "$(cat "$job"&#10;)" 2&gt;&gt;"$LOG"); then&#10;&gt;       mv "$job" "$ROOT/done/gemini_$n"&#10;&gt;       python3 "$REP" google "$n" OK "$reply" 2&gt;/dev/null &#10;|| true&#10;&gt;     else&#10;&gt;       mv "$job" "$ROOT/fail/$n"&#10;&gt;       python3 "$REP" google "$n" FAIL "$(tail -30 "$LOG")&#10;" 2&gt;/dev/null || true&#10;&gt;     fi&#10;&gt;   done&#10;&gt; fi&#10;&gt; termux-toast -s "Broccoli: idle" 2&gt;/dev/null || true&#10;&gt; echo "=== idle $(date) ===" | tee -a "$LOG"&#10;&gt; &apos;&apos;&apos;)&#10;&gt; (H / "broccoli_worker.sh").chmod(0o755)&#10;&gt;&#10;&gt; # seed project + short job (not full XML test)&#10;&gt; (ROOT / "PROJECT.md").write_text("""# Broccoli&#10;&gt; Goal: reliable UI automation from user requests (Grok + G&#10;oogle AI Mode).&#10;&gt; Stack: broccoli_bootstrap.py, google_ai_bootstrap.py, bro&#10;cc daemon.&#10;&gt; Known: send tap 1001,1338; no clear_composer; compose wra&#10;ps context each turn.&#10;&gt; """)&#10;&gt; (ROOT / "thread" / "conversation.md").write_text("# Brocc&#10;oli thread\n\n")&#10;&gt; print("CTX OK")&#10;&gt; CTX&#10;CTX OK&#10;~ $&#10;~ $ python3 -m py_compile ~/broccoli_bootstrap.py ~/broccol&#10;i_compose.py &amp;&amp; echo COMPILE_OK&#10;COMPILE_OK&#10;~ $ export PATH="$HOME:$PATH"&#10;~ $ brocc run-once&#10;=== worker Sun Jul  5 22:13:50 EDT 2026 ===&#10;=== idle Sun Jul  5 22:13:53 EDT 2026 ===&#10;~ $ brocc report&#10;=== BROCCOLI REPORT ===&#10;time: 2026-07-05 22:12:54&#10;provider: grok&#10;job: 00_project_bootstrap.txt&#10;status: OK&#10;reply: STEP launch_grok&#10;  focus: mCurrentFocus=Window{f6e5de u0 ai.x.grok/ai.x.grok&#10;.main.GrokActivity}&#10;STEP dump_ui&#10;&lt;?xml version=&apos;1.0&apos; encoding=&apos;UTF-8&apos; standalone=&apos;yes&apos; ?&gt;&lt;hi&#10;erarchy rotation="0"&gt;&lt;node index="0" text="" resource-id=""&#10; class="android.widget.FrameLayout" package="ai.x.grok" con&#10;tent-desc="" checkable="false" checked="false" clickable="f&#10;alse" enabled="true" focusable="false" focused="false" scro&#10;llable="false" long-clickable="false" password="false" sele&#10;cted="false" bounds="[0,0][1080,2408]"&gt;&lt;node index="0" text&#10;="" resource-id="" class="android.widget.LinearLayout" pack&#10;age="ai.x.grok" content-desc="" checkable="false" checked="&#10;false" clickable="false" enabled="true" focusable="false" f&#10;ocused="false" scrollable="false" long-clickable="false" pa&#10;ssword="false" selected="false" bounds="[0,0][1080,2408]"&gt;&lt;&#10;node index="0" text="" resource-id="" class="android.widget&#10;.FrameLayout" package="ai.x.grok" content-desc="" checkable&#10;="false" checked="false" clickable="false" enabled="true" f&#10;ocusable="false" focused="false" scrollable="false" long-cl&#10;ickable="false" password="false" selected="false" bounds="[&#10;0,0][1080,2408]"&gt;&lt;node index="0" text="" resource-id="ai.x.&#10;grok:id/action_bar_root" class="android.widget.LinearLayout&#10;" package="ai.x.grok" c