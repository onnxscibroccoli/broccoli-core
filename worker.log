de index="0" text="Thoughts" resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,605][948,650]" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,715][1048,2408]"><node index="0" text="NEXT_STEP: Harden clean_reply on the worker path (before report + thread), add strip_fences to broccoli_compose.py rules, and add broccoli_accept.py to run TASK.md acceptance checks and emit TASK_COMPLETE when all pass." resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,715][1048,935]" /><node index="1" text="TERMINUX:" resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,969][219,1009]" /><node index="2" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,1043][1048,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[64,1023][1016,1129]"><node index="0" text="BASH" resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[64,1072][130,1101]" /><node index="1" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[859,1023][1016,1129]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[859,1023][1016,1129]"><node index="0" text="Copy" resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[933,1071][995,1101]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[859,1054][1016,1118]" /></node></node></node><node index="1" text="" resource-id="" class="android.widget.HorizontalScrollView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[32,1129][1048,2408]"><node index="0" text='export PATH="$HOME:$PATH"&#10;python3 &lt;&lt; &apos;PATCH&apos;&#10;from pathlib import Path&#10;import re, json, subprocess, sys&#10;&#10;H = Path.home()&#10;R = H / "broccoli"&#10;&#10;def clean_reply(r):&#10;    r = (r or "").strip()&#10;    if "&lt;?xml" in r:&#10;        r = r.split("&lt;?xml")[0].strip()&#10;    if "=== BROCCOLI REPORT ===" in r:&#10;        r = r.split("=== BROCCOLI REPORT ===")[0].strip()&#10;    lines = []&#10;    for ln in r.splitlines():&#10;        s = ln.strip()&#10;        if s.startswith("STEP "):&#10;            continue&#10;        if s in ("=== END REPORT ===",) or s.startswith("time: ") or s.startswith("provider: "):&#10;            continue&#10;        if s.startswith("job: ") or s.startswith("status: ") or s.startswith("reply: "):&#10;            continue&#10;        if s.startswith("extra: ") or s.startswith("log: "):&#10;            continue&#10;        lines.append(ln)&#10;    r = "\n".join(lines).strip()&#10;    return r[:2000] if r else "(empty reply)"&#10;&#10;# report.py — ensure clean_reply exists&#10;rp = H / "broccoli_report.py"&#10;t = rp.read_text()&#10;if "def clean_reply" not in t:&#10;    t = "def clean_reply(r):\n    return %r\n\n" % clean_reply("__PLACEHOLDER__").replace("__PLACEHOLDER__", "(r or &apos;&apos;)") &#10;# simpler: inject function&#10;if "def clean_reply" not in rp.read_text():&#10;    inj = &apos;&apos;&apos;&#10;def clean_reply(r):&#10;    r = (r or "").strip()&#10;    if "&lt;?xml" in r: r = r.split("&lt;?xml")[0].strip()&#10;    if "=== BROCCOLI REPORT ===" in r: r = r.split("=== BROCCOLI REPORT ===")[0].strip()&#10;    skip = ("STEP ", "time:", "provider:", "job:", "status:", "reply:", "extra:", "log:", "=== END")&#10;    lines = [ln for ln in r.splitlines() if not any(ln.strip().startswith(x) for x in skip) and "=== BROCCOLI" not in ln]&#10;    r = "\\n".join(lines).strip()&#10;    return (r[:2000] if r else "(empty reply)")&#10;&apos;&apos;&apos;&#10;    t = rp.read_text().replace("def finish(", inj + "\ndef finish(", 1)&#10;    t = t.replace("(reply or \"\")[:2000]", "clean_reply(reply)")&#10;    rp.write_text(t)&#10;&#10;# compose — no fences in TERMINUX + TASK body&#10;cp = H / "broccoli_compose.py"&#10;s = cp.read_text()&#10;if "Never wrap TERMINUX" not in s:&#10;    s = s.replace(&#10;        &apos;"  REPORT_FOR_MAC: (max 8 lines, pasteable; no XML dumps)",&apos;,&#10;        &apos;"  REPORT_FOR_MAC: (max 8 lines, pasteable; no XML dumps)",\n&apos;&#10;        &apos;        "- TERMINUX must be raw: python3 &lt;&lt; \\&apos;QUOTE\\&apos; only — no ``` markdown fences.",\n&apos;&#10;        &apos;        "- Never wrap TERMINUX in code fences; Mac pastes heredoc directly.",&apos;,&#10;        1,&#10;    )&#10;if "TASK.md" not in s:&#10;    s = s.replace(&#10;        &apos;PROJECT = ROOT / "PROJECT.md"&apos;,&#10;        &apos;PROJECT = ROOT / "PROJECT.md"\nTASK = ROOT / "tasks" / "current" / "TASK.md"&apos;,&#10;    )&#10;    s = s.replace(&#10;        &apos;        "--- PROJECT ---",&apos;,&#10;        &apos;        "--- TASK (current) ---",\n        read(TASK, 2000) or "(no TASK.md)",\n        "",\n        "--- PROJECT ---",&apos;,&#10;    )&#10;cp.write_text(s)&#10;&#10;# acceptance runner&#10;(H / "broccoli_accept.py").write_text(r&apos;&apos;&apos;#!/usr/bin/env python3&#10;import subprocess, sys, json&#10;from pathlib import Path&#10;R = Path.home() / "broccoli"&#10;def run(cmd):&#10;    return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=120)&#10;ok = True&#10;msgs = []&#10;r = run("python3 ~/broccoli_bootstrap.py grok-smoke 2&gt;&amp;1 | tail -5")&#10;if "PASS" not in (r.stdout or "") + (r.stderr or ""):&#10;    ok = False; msgs.append("grok-smoke not PASS")&#10;else:&#10;    msgs.append("grok-smoke PASS")&#10;r = run("python3 ~/broccoli_ui.py ensure 2&gt;&amp;1 | tail -1")&#10;line = (r.stdout or "").strip()&#10;if "send" not in line and &apos;"send"&apos; not in line:&#10;    ok = False; msgs.append("ui ensure missing send")&#10;else:&#10;    msgs.append("ui ensure ok")&#10;rep = (R / "reports" / "latest.txt").read_text(errors="replace") if (R / "reports" / "latest.txt").is_file() else ""&#10;if rep.count("=== BROCCOLI REPORT ===") &gt; 1:&#10;    ok = False; msgs.append("nested report in latest.txt")&#10;else:&#10;    msgs.append("report clean")&#10;summary = "; ".join(msgs)&#10;if ok:&#10;    print("TASK_COMPLETE: " + summary)&#10;    subprocess.run([sys.executable, str(Path.home()/"broccoli_task.py"), "complete", summary], check=False)&#10;else:&#10;    print("TASK_INCOMPLETE: " + summary)&#10;    sys.exit(1)&#10;&apos;&apos;&apos;)&#10;(H / "broccoli_accept.py").chmod(0o755)&#10;&#10;# worker: clean reply before report/thread&#10;w = H / "broccoli_worker.sh"&#10;txt = w.read_text()&#10;if "broccoli_clean_stdout.py" not in txt:&#10;    (H / "broccoli_clean_stdout.py").write_text(&#10;        "#!/usr/bin/env python3\nimport sys\n" +&#10;        "def clean_reply(r):\n" +&#10;        "    r=(r or &apos;&apos;).strip()\n" +&#10;        "    if &apos;=== BROCCOLI REPORT ===&apos; in r: r=r.split(&apos;=== BROCCOLI REPORT ===&apos;)[0].strip()\n" +&#10;        "    if &apos;&lt;?xml&apos; in r: r=r.split(&apos;&lt;?xml&apos;)[0].strip()\n" +&#10;        "    return r[:2000]\n" +&#10;        "print(clean_reply(sys.stdin.read()))\n"&#10;    )&#10;    (H / "broccoli_clean_stdout.py").chmod(0o755)&#10;    txt = txt.replace(&#10;        &apos;if reply=$(python3 "$GROK" grok-ask "$prompt" 2&gt;&gt;"$LOG"); then&apos;,&#10;        &apos;if raw=$(python3 "$GROK" grok-ask "$prompt" 2&gt;&gt;"$LOG"); then\n    reply=$(printf "%s" "$raw" | python3 "$HOME/broccoli_clean_stdout.py")&apos;,&#10;    )&#10;    w.write_text(txt)&#10;&#10;# scrub thread again&#10;th = R / "thread" / "conversation.md"&#10;th.write_text("# Broccoli thread\n\n")&#10;print("PATCH OK")&#10;PATCH&#10;&#10;python3 -m py_compile ~/broccoli_report.py ~/broccoli_compose.py ~/broccoli_accept.py ~/broccoli_clean_stdout.py 2&gt;/dev/null &amp;&amp; echo COMPILE_OK&#10;python3 ~/broccoli_accept.py&#10;brocc report' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,1154][1048,2408]" /></node></node></node></node><node index="1" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,1819][1080,1966]"><node index="0" text="" resource-id="" class="android.widget.Button" package="ai.x.grok" content-desc="Scroll to bottom" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,1819][1048,1945]" /></node></node><node index="1" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2008][1080,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2008][1080,2282]" /><node index="1" text="" resource-id="chat_text_input" class="android.widget.EditText" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="