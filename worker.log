Home|Search|Grok|Copy|Share|Regenerate)$", _re.I)&#10;    skip_rid = ("action_bar", "navigation", "status_bar", "toolbar")&#10;    cands = []&#10;    for m in _re.finditer(&#10;        r&apos;text="([^"]*)"[^&gt;]*bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"&apos;, xml):&#10;        t, y1 = m.group(1), int(m.group(3))&#10;        if not t or len(t.strip()) &lt; 12:&#10;            continue&#10;        ts = t.strip()&#10;        if junk.match(ts):&#10;            continue&#10;        if "http://" in ts or ts.startswith("You are co-developing"):&#10;            continue&#10;        cands.append((len(ts), y1, ts))&#10;    for m in _re.finditer(&#10;        r&apos;content-desc="([^"]*)"[^&gt;]*bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"&apos;, xml):&#10;        t, y1 = m.group(1), int(m.group(3))&#10;        if not t or len(t.strip()) &lt; 12 or junk.match(t.strip()):&#10;            continue&#10;        cands.append((len(t.strip()), y1, t.strip()))&#10;    if not cands:&#10;        for m in _re.finditer(r&apos;text="([^"]{20,})"&apos;, xml):&#10;            t = m.group(1).strip()&#10;            if not junk.match(t) and "BROCCOLI CONTEXT" not in t:&#10;                cands.append((len(t), 0, t))&#10;    if not cands:&#10;        log("last_reply no cands")&#10;        return ""&#10;    cands.sort(key=lambda x: (x[1], x[0]))&#10;    best = cands[-1][2]&#10;    log("last_reply len", len(best), "preview", best[:80])&#10;    return best&#10;&apos;&apos;&apos;&#10;&#10;if "def last_reply" in s:&#10;    s = re.sub(r"def last_reply\([^)]*\):.*?(?=\ndef |\nclass |\Z)", last_reply_fn + "\n", s, count=1, flags=re.S)&#10;else:&#10;    s = last_reply_fn + "\n" + s&#10;&#10;# extend poll&#10;if "_wait_reply_after_send" in s:&#10;    s = s.replace("_wait_reply_after_send(70)", "_wait_reply_after_send(90)", 1)&#10;elif "for _i in range" in s and "_wait_reply_after_send" in s:&#10;    pass&#10;&#10;bp.write_text(s)&#10;&#10;# requeue: newest fail -&gt; inbox once&#10;fail = sorted((R / "fail").glob("*.txt"), key=lambda p: p.stat().st_mtime, reverse=True)&#10;inbox = R / "inbox" / "grok"&#10;inbox.mkdir(parents=True, exist_ok=True)&#10;if fail:&#10;    src = fail[0]&#10;    dst = inbox / ("retry_" + src.name)&#10;    if not dst.exists():&#10;        dst.write_text(src.read_text(errors="replace"))&#10;        src.unlink(missing_ok=True)&#10;&#10;(R / "thread" / "conversation.md").write_text("# Broccoli thread\n\n")&#10;cp = H / "broccoli_compose.py"&#10;if cp.is_file():&#10;    t = cp.read_text()&#10;    if "sanitize_thread" not in t:&#10;        t = t.replace(&#10;            &apos;read(THREAD, 2500)&apos;,&#10;            &apos;read(THREAD, 2500).split("=== BROCCOLI REPORT ===")[0]&apos;,&#10;            1,&#10;        )&#10;        cp.write_text(t)&#10;&#10;cal = H / ".grok_ui_cal.json"&#10;cal.write_text(json.dumps({"send": [1001, 1338], "composer": [540, 2200]}, indent=2))&#10;print("END OK")&#10;END&#10;&#10;python3 -m py_compile ~/broccoli_bootstrap.py &amp;&amp; echo COMPILE_OK&#10;brocc ask grok "USER_ACK extraction+retry. NEXT_STEP one line. TERMINUX: echo READY. TEST: echo OK. REPORT_FOR_MAC: four lines min eighty chars about last_reply longest bubble."&#10;brocc run-once&#10;brocc report&#10;brocc log 20' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,0][1048,86]" /></node></node><node index="1" text="TEST: brocc report → status: OK and reply: contains READY or NEXT_STEP (≥80 chars total in reply body), or FAIL with last_reply len in brocc log; not junk reply without log lines." resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" select