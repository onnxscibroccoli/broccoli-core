10;    if "&lt;?xml" in r:&#10;        r = r.split("&lt;?xml")[0].strip()&#10;    junk = re.compile(r"^(Thoughts?|Thinking\.?|Ask anything)$", re.I)&#10;    skip = ("time:", "provider:", "job:", "status:", "reply:", "extra:", "log:", "=== END")&#10;    lines = [ln for ln in r.splitlines()&#10;             if not any(ln.strip().startswith(x) for x in skip)&#10;             and "=== BROCCOLI" not in ln and not junk.match(ln.strip())]&#10;    r = "\n".join(lines).strip()&#10;    return r[:3500] if len(r) &gt;= 12 else ""&#10;&#10;job, raw = sys.argv[1], sys.argv[2] if len(sys.argv) &gt; 2 else ""&#10;reply = clean(raw)&#10;if not reply:&#10;    sys.exit(0)&#10;THREAD.parent.mkdir(parents=True, exist_ok=True)&#10;with open(THREAD, "a", encoding="utf-8") as f:&#10;    f.write("\n\n## %s\n**job:** %s\n**grok:**\n%s\n" % (time.strftime("%Y-%m-%d %H:%M"), job, reply))&#10;&apos;&apos;&apos;)&#10;os.chmod(H / "broccoli_thread_append.py", 0o755)&#10;&#10;grok_block = r&apos;&apos;&apos;  for job in "$ROOT/inbox/grok"/*.txt; do&#10;    [ -f "$job" ] || continue&#10;    n=$(basename "$job")&#10;    echo "--- grok $n ---" &gt;&gt;"$LOG"&#10;    prompt=$(python3 "$HOME/broccoli_compose.py" "$job" 2&gt;&gt;"$LOG") || prompt=$(cat "$job")&#10;    raw=""&#10;    if ! raw=$(python3 "$GROK" grok-ask "$prompt" 2&gt;&gt;"$LOG"); then&#10;      echo "grok-ask exit fail" &gt;&gt;"$LOG"&#10;      mv "$job" "$ROOT/fail/$n" 2&gt;/dev/null || true&#10;      python3 "$REP" grok "$n" FAIL "grok-ask exit (empty/junk after scroll)" 2&gt;&gt;"$LOG" || true&#10;      continue&#10;    fi&#10;    if [ -z "$(printf &apos;%s&apos; "$raw" | tr -d &apos;[:space:]&apos;)" ]; then&#10;      echo "reply empty fail" &gt;&gt;"$LOG"&#10;      mv "$job" "$ROOT/fail/$n" 2&gt;/dev/null || true&#10;      python3 "$REP" grok "$n" FAIL "empty stdout" 2&gt;&gt;"$LOG" || true&#10;      continue&#10;    fi&#10;    reply=$(printf &apos;%s&apos; "$raw" | python3 "$HOME/broccoli_clean_stdout.py" 2&gt;/dev/null)&#10;    if ! printf &apos;%s&apos; "$reply" | python3 "$HOME/broccoli_reply_ok.py" &gt;/dev/null 2&gt;&amp;1; then&#10;      echo "junk reply fail" &gt;&gt;"$LOG"&#10;      mv "$job" "$ROOT/fail/$n" 2&gt;/dev/null || true&#10;      python3 "$REP" grok "$n" FAIL "junk reply" 2&gt;&gt;"$LOG" || true&#10;      continue&#10;    fi&#10;    reply=$(printf &apos;%s&apos; "$reply" | python3 "$HOME/broccoli_reply_ok.py")&#10;    on_grok_ok "$n" "$reply" 2&gt;/dev/null || true&#10;    python3 "$REP" grok "$n" OK "$reply" 2&gt;&gt;"$LOG" || true&#10;    python3 "$HOME/broccoli_thread_append.py" "$n" "$reply" 2&gt;&gt;"$LOG" || true&#10;    mv "$job" "$ROOT/done/$n" 2&gt;/dev/null || true&#10;  done&apos;&apos;&apos;&#10;&#10;w = H / "broccoli_worker.sh"&#10;txt = w.read_text()&#10;if "on_grok_ok" not in txt:&#10;    txt = &apos;on_grok_ok() {\n  echo "$2" | grep -q "TASK_COMPLETE:" &amp;&amp; python3 "$HOME/broccoli_task.py" complete "$(echo "$2" | sed -n \&apos;s/.*TASK_COMPLETE:\\s*//p\&apos; | head -1)" 2&gt;/dev/null || true\n}\n&apos; + txt&#10;&#10;# replace grok for-loop body: from "for job in" grok to matching "done" (first grok loop only)&#10;m = re.search(r&apos;  for job in "\$ROOT/inbox/grok"/\*\.txt; do.*?  done\n&apos;, txt, re.S)&#10;if m:&#10;    txt = txt[:m.start()] + grok_block + txt[m.end():]&#10;else:&#10;    txt += "\n" + grok_block + "\n"&#10;&#10;w.write_text(txt)&#10;&#10;# grok-ask MUST exit 1 on junk&#10;bp = H / "broccoli_bootstrap.py"&#10;s = bp.read_text()&#10;if &apos;sys.exit(1)&apos; not in s.split(&apos;grok-ask&apos;)[-1][:800]:&#10;    patch = &apos;&apos;&apos;&#10;    if a == "grok-ask":&#10;        prompt = sys.argv[2] if len(sys.argv) &gt; 2 else sys.stdin.read()&#10;        reply = grok_ask(prompt)&#10;        import subprocess as _sp2&#10;        _p = _sp2.run([sys.executable, os.path.expanduser("~/broccoli_reply_ok.py")],&#10;                      input=(reply or "").encode(), capture_output=True)&#10;        if _p.returncode != 0:&#10;            log("grok-ask FAIL", repr((reply or "")[:80]))&#10;            sys.exit(1)&#10;        print(_p.stdout.decode().strip(), flush=True)&#10;&apos;&apos;&apos;&#10;    # replace grok-ask block if exists&#10;    s2 = re.sub(&#10;        r&apos;if a == "grok-ask":.*?print\(reply&apos;,&#10;        patch.strip() + &apos;\n        # was print(reply&apos;,&#10;        s,&#10;        count=1,&#10;        flags=re.S,&#10;    )&#10;    if s2 != s:&#10;        s = s2&#10;    elif &apos;if a == "grok-ask":&apos; not in s:&#10;        s += "\n" + patch&#10;&#10;bp.write_text(s)&#10;&#10;th = R / "thread" / "conversation.md"&#10;th.write_text("# Broccoli thread\n\n")&#10;(R / "user" / "PENDING.md").write_text("(acknowledged — worker honors grok-ask exit 1)\n")&#10;print("END OK")&#10;END&#10;&#10;python3 -m py_compile ~/broccoli_bootstrap.py &amp;&amp; echo COMPILE_OK&#10;brocc stop; brocc start&#10;brocc ask grok "USER_ACK worker exit wired. NEXT_STEP one line. TERMINUX: echo LOOP_OK. TEST: echo PASS. REPORT_FOR_MAC: five lines about empty fail not OK."&#10;brocc run-once&#10;brocc report&#10;brocc log 25' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,0][1048,822]" /></node></node><node index="1" text="TEST: brocc report → status: FAIL with empty/junk or status: OK with reply: containing LOOP_OK (≥12 chars); brocc log must show grok-ask exit fail or reply empty fail, not OK (empty reply)." resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,881][1048,1056]" /><node index="2" text="REPORT_FOR_MAC:" resource-id="" class="android.widget.TextV