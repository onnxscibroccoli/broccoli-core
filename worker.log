se" selected="false" bounds="[32,455][1048,581]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickablry():&#10;    p = load_policy()&#10;    p["mode"] = "automation_secondary"&#10;    save_policy(p)&#10;    return p&#10;&apos;&apos;&apos;)&#10;&#10;(ROOT / "broccoli_secondary_display.py").write_text(r&apos;&apos;&apos;#!/usr/bin/env python3&#10;import sys, json&#10;from pathlib import Path&#10;sys.path.insert(0, str(Path.home() / "broccoli/lib"))&#10;from display_lane import (&#10;    load_policy, enable_user_primary, enable_automation_secondary,&#10;    may_run_foreground_ui, user_is_idle, enqueue_deferred, pop_deferred,&#10;)&#10;&#10;def main():&#10;    cmd = (sys.argv[1] if len(sys.argv) &gt; 1 else "status").lower()&#10;    if cmd == "on" or cmd == "user-primary":&#10;        print(json.dumps(enable_user_primary()))&#10;    elif cmd == "off" or cmd == "secondary":&#10;        print(json.dumps(enable_automation_secondary()))&#10;    elif cmd == "status":&#10;        p = load_policy()&#10;        print(json.dumps({&#10;            **p,&#10;            "user_idle": user_is_idle(),&#10;            "may_run_ui": may_run_foreground_ui(),&#10;        }, indent=2))&#10;    elif cmd == "defer" and len(sys.argv) &gt;= 3:&#10;        print(json.dumps(enqueue_deferred(sys.argv[2], {"argv": sys.argv[3:]})))&#10;    elif cmd == "run-deferred":&#10;        j = pop_deferred()&#10;        print(json.dumps(j or {"empty": True}))&#10;    elif cmd == "may-run":&#10;        print("yes" if may_run_foreground_ui() else "no")&#10;    else:&#10;        print("usage: secondary on|off|status|may-run|defer &lt;type&gt;|run-deferred")&#10;        sys.exit(1)&#10;&#10;if __name__ == "__main__":&#10;    main()&#10;&apos;&apos;&apos;)&#10;(ROOT / "broccoli_secondary_display.py").chmod(0o755)&#10;Path(HOME / "broccoli_secondary_display.py").write_bytes((ROOT / "broccoli_secondary_display.py").read_bytes())&#10;(HOME / "broccoli_secondary_display.py").chmod(0o755)&#10;&#10;(ROOT / "docs" / "RUTO_BRIDGE.md").write_text("""# Ruto-GLM bridge (optional true virtual display)&#10;&#10;Broccoli **secondary lane v0** simulates "phone back" by deferring UI automation until user idle.&#10;For **real** background virtual screen (Open-AutoGLM on display 1), install [Ruto-GLM](https://github.com/iamr0s/Ruto-GLM):&#10;&#10;1. Shizuku + Ruto permission&#10;2. Create virtual screen in Ruto&#10;3. Run Grok/Google automation task on that screen (not main)&#10;4. User uses main screen normally&#10;&#10;Broccoli integration (manual v0):&#10;- `brocc secondary on` — default; worker defers grok jobs when not idle&#10;- Set `~/broccoli/meta/display_policy.json` → `"ruto_installed": true`, `"ruto_virtual_screen": "&lt;name&gt;"`&#10;- Future: `brocc ruto-delegate` exports job JSON for Ruto task runner&#10;&#10;Pilot task `deep-research-pilot` (google) can run in Chrome on virtual screen via Ruto while user chats on main.&#10;""")&#10;&#10;# brocc stub&#10;brocc = HOME / "brocc"&#10;if brocc.is_file():&#10;    t = brocc.read_text()&#10;    if "secondary)" not in t:&#10;        stub = &apos;&apos;&apos;&#10;secondary)&#10;  exec python3 "$HOME/broccoli_secondary_display.py" "${@:2}"&#10;  ;;&#10;&apos;&apos;&apos;&#10;        if "esac" in t:&#10;            t = t.replace("esac", stub + "esac", 1)&#10;        brocc.write_text(t)&#10;        print("brocc secondary stub")&#10;&#10;# worker gate: skip foreground grok when may_run_ui is no&#10;for wp in [HOME / "broccoli_worker.sh", ROOT / "broccoli_worker.sh"]:&#10;    if not wp.exists():&#10;        continue&#10;    wt = wp.read_text()&#10;    gate = &apos;&apos;&apos;&#10;# BROCC_DISPLAY_LANE&#10;if python3 "$HOME/broccoli_secondary_display.py" may-run 2&gt;/dev/null | grep -q no; then&#10;  python3 "$HOME/broccoli_secondary_display.py" defer grok_job 2&gt;/dev/null || true&#10;  brocc research round 2&gt;/dev/null || true&#10;  exit 0&#10;fi&#10;&apos;&apos;&apos;&#10;    if "BROCC_DISPLAY_LANE" not in wt:&#10;        wp.write_text(gate + wt)&#10;        print("patched", wp)&#10;    break&#10;&#10;# default: user gets phone back&#10;import subprocess&#10;subprocess.run(["python3", str(HOME / "broccoli_secondary_display.py"), "on"], check=False)&#10;&#10;scope = ROOT / "AUTOMATION_SCOPE.md"&#10;extra = "- Secondary display lane v0: brocc secondary on (idle-gated UI); Ruto-GLM optional true virtual screen (docs/RUTO_BRIDGE.md).\n"&#10;if scope.exists() and "Secondary display lane" not in scope.read_text():&#10;    scope.write_text(scope.read_text().rstrip() + "\n" + extra)&#10;&#10;print("secondary_display v0 ready")&#10;print("user phone back: brocc secondary on")&#10;END&#10;brocc secondary on&#10;brocc godmode start 2&gt;/dev/null || true&#10;brocc recover&#10;brocc research round 2&gt;/dev/null || true&#10;brocc run-once&#10;brocc report' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,1067][1048,2408]" /></node></node></node></node><node index="1" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,1819][1080,1966]"><node index="0" text="" resource-id="" class="android.widget.Button" package="ai.x.grok" content-desc="Scroll to bottom" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,1819][1048,1945]" /></node></node><node index="1" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable=