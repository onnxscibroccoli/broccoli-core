H = Path.home()&#10;&gt; ROOT = H / "broccoli"&#10;vider,&#10;        "job: "+&gt; ROOT.mkdir(parents=True, exist_ok=True)&#10;&gt; for d in ("inbox/grok","inbox/gemini","done","fail","runs&#10;","reports"):&#10;&gt;     (ROOT/d).mkdir(parents=True, exist_ok=True)&#10;&gt;&#10;&gt; (H/"broccoli_report.py").write_text(r&apos;&apos;&apos;#!/usr/bin/env py&#10;thon3&#10;&gt; import sys, subprocess, time&#10;&gt; from pathlib import Path&#10;&gt; ROOT = Path.home() / "broccoli"&#10;&gt; def clip(t):&#10;&gt;     try: subprocess.run(["termux-clipboard-set"], input=t&#10;.encode(), timeout=8, check=False)&#10;&gt;     except Exception: pass&#10;&gt; def finish(provider, job, status, reply="", extra=""):&#10;&gt;     ts = time.strftime("%Y-%m-%d %H:%M:%S")&#10;&gt;     body = "\n".join(["=== BROCCOLI REPORT ===","time: "+&#10;ts,"provider: "+provider,&#10;&gt;         "job: "+job,"status: "+status,"reply: "+(reply or&#10; "")[:2000],&#10;&gt;         "extra: "+(extra or "")[:800],"log: ~/broccoli/da&#10;emon.log","=== END REPORT ==="])&#10;&gt;     (ROOT/"reports/latest.txt").write_text(body)&#10;&gt;     (ROOT/"LAST_RUN.txt").write_text("%s %s %s\n"%(provid&#10;er,status,job))&#10;&gt;     print(body, flush=True); clip(body)&#10;&gt;     subprocess.run(["termux-toast","-s","Broccoli %s %s"%&#10;(status,job[:35])], timeout=5, check=False)&#10;&gt;     if status in ("OK","PASS"):&#10;&gt;         subprocess.run(["termux-vibrate","-d","400"], tim&#10;eout=5, check=False)&#10;&gt; if __name__=="__main__":&#10;&gt;     finish(sys.argv[1],sys.argv[2],sys.argv[3],sys.argv[4&#10;] if len(sys.argv)&gt;4 else "")&#10;&gt; &apos;&apos;&apos;)&#10;&gt; (H/"broccoli_report.py").chmod(0o755)&#10;&gt;&#10;&gt; (H/"broccoli_worker.sh").write_text(r&apos;&apos;&apos;#!/data/data/com.&#10;termux/files/usr/bin/bash&#10;&gt; ROOT="$HOME/broccoli"&#10;&gt; GROK="$HOME/broccoli_bootstrap.py"&#10;&gt; GAI="$HOME/google_ai_bootstrap.py"&#10;&gt; REP="$HOME/broccoli_report.py"&#10;&gt; LOG="$ROOT