ui/last_capture.txt"&#10;    if cap.exists():&#10;        t = cap.read_text(errors="replace")[:MAX_UI_BYTES]&#10;        summary = {"ts": time.time(), "bytes": len(t), "source": "last_capture.txt", "preview": t[:1200]}&#10;        UI_LATEST.write_text(json.dumps(summary, indent=2))&#10;        return summary&#10;    return {"ts": time.time(), "error": "no_ui_dump", "bytes": 0}&#10;&#10;def record_touch(x, y, action="tap", meta=None):&#10;    ev = {"ts": time.time(), "x": int(x), "y": int(y), "action": action, "meta": meta or {}}&#10;    with _lock:&#10;        _touch_deque.append(ev)&#10;        with TOUCH_RING.open("a") as f:&#10;            f.write(json.dumps(ev) + "\n")&#10;    st = load_state()&#10;    st["touches"] = st.get("touches", 0) + 1&#10;    save_state(st)&#10;    return ev&#10;&#10;def hook_bootstrap_tap(x, y):&#10;    """Call from send-tap path to correlate user/automation touches with UI."""&#10;    return record_touch(x, y, action="send_tap", meta={"origin": "bootstrap"})&#10;&#10;def start_recording():&#10;    global _recording&#10;    _recording = True&#10;    st = load_state()&#10;    st["recording"] = True&#10;    st["started_at"] = time.time()&#10;    save_state(st)&#10;    dump_ui_fast()&#10;    return st&#10;&#10;def stop_recording():&#10;    global _recording&#10;    _recording = False&#10;    st = load_state()&#10;    st["recording"] = False&#10;    save_state(st)&#10;    return st&#10;&#10;def export_session(label="session"):&#10;    """Package UI + touches + context for AGI (Mac paste or API later)."""&#10;    SESS = GM / "sessions"&#10;    SESS.mkdir(parents=True, exist_ok=True)&#10;    sid = f"{label}_{int(time.time())}"&#10;    out = SESS / f"{sid}.json"&#10;    touches = []&#10;    if TOUCH_RING.exists():&#10;        for line in TOUCH_RING.read_text(errors="replace").splitlines()[-MAX_TOUCH:]:&#10;            try:&#10;                touches.append(json.loads(line))&#10;            except Exception:&#10;                pass&#10;    ui = {}&#10;    if UI_LATEST.exists():&#10;        try:&#10;            ui = json.loads(UI_LATEST.read_text())&#10;        except Exception:&#10;            ui = {"raw": UI_LATEST.read_text(errors="replace")[:8000]}&#10;    task = ""&#10;    tp = HOME / "broccoli/tasks/current/TASK.md"&#10;    if tp.exists():&#10;        task = tp.read_text(errors="replace")[:6000]&#10;    pkg = {&#10;        "id": sid,&#10;        "exported_at": time.time(),&#10;        "state": load_state(),&#10;        "task_excerpt": task,&#10;        "ui_latest": ui,&#10;        "touches_tail": touches[-80:],&#10;        "agi_prompt": (&#10;            "Given UI dump preview + touch sequence, propose Broccoli automation: "&#10;            "stable selectors, scroll-before-read, tap send not Enter, retry on suggestion junk. "&#10;            "Output: NEXT_STEP, TERMINUX patch, TEST."&#10;        ),&#10;    }&#10;    out.write_text(json.dumps(pkg, indent=2))&#10;    (SESS / "LATEST.json").write_text(json.dumps({"path": str(out), "id": sid}, indent=2))&#10;    return str(out)&#10;&#10;def agi_packet_compact():&#10;    """Minimal JSON for low-latency upstream (no huge XML in chat)."""&#10;    ui = json.loads(UI_LATEST.read_text()) if UI_LATEST.exists() else {}&#10;    return {&#10;        "ts": time.time(),&#10;        "ui_preview": (ui.get("preview") or "")[:2000],&#10;        "touches": sum(1 for _ in open(TOUCH_RING)) if TOUCH_RING.exists() else 0,&#10;        "state": load_state(),&#10;    }&#10;&apos;&apos;&apos;)&#10;&#10;# --- CLI entry ---&#10;(ROOT / "broccoli_godmode.py").write_text(r&apos;&apos;&apos;#!/usr/bin/env python3&#10;import sys&#10;from pathlib import Path&#10;sys.path.insert(0, str(Path.home() / "broccoli/lib"))&#10;from godmode_core import (&#10;    start_recording, stop_recording, dump_ui_fast,&#10;    export_session, agi_packet_compact, record_touch, hook_bootstrap_tap,&#10;)&#10;&#10;def main():&#10;    cmd = (sys.argv[1] if len(sys.argv) &gt; 1 else "status").lower()&#10;    if cmd == "start":&#10;        print(json.dumps(start_recording()))&#10;    elif cmd == "stop":&#10;        print(json.dumps(stop_recording()))&#10;    elif cmd == "dump":&#10;        print(json.dumps(dump_ui_fast()))&#10;    elif cmd == "export":&#10;        label = sys.argv[2] if len(sys.argv) &gt; 2 else "godmode"&#10;        print(export_session(label))&#10;    elif cmd == "packet":&#10;        import json&#10;        print(json.dumps(agi_packet_compact()))&#10;    elif cmd == "touch" and len(sys.argv) &gt;= 4:&#10;        print(record_touch(int(sys.argv[2]), int(sys.argv[3])))&#10;    elif cmd == "hook-tap" and len(sys.argv) &gt;= 4:&#10;        print(hook_bootstrap_tap(int(sys.argv[2]), int(sys.argv[3])))&#10;    elif cmd == "status":&#10;        from godmode_core import load_state&#10;        import json&#10;        print(json.dumps(load_state(), indent=2))&#10;    else:&#10;        print("usage: godmode start|stop|dump|export [label]|packet|touch X Y|status")&#10;        sys.exit(1)&#10;&#10;if __name__ == "__main__":&#10;    main()&#10;&apos;&apos;&apos;)&#10;(ROOT / "broccoli_godmode.py").chmod(0o755)&#10;Path(HOME / "broccoli_godmode.py").write_bytes((ROOT / "broccoli_godmode.py").read_bytes())&#10;(HOME / "broccoli_godmode.py").chmod(0o755)&#10;&#10;# --- async dumper loop (lightweight, 3s interval when recording) ---&#10;(ROOT / "tools" / "godmode_watcher.py").write_text(r&apos;&apos;&apos;#!/usr/bin/env python3&#10;import time, sys&#10;from pathlib import Path&#10;sys.path.insert(0, str(Path.home() / "broccoli/lib"))&#10;from godmode_core import load_state, dump_ui_fast&#10;&#10;def main():&#10;    interval = float(sys.argv[1]) if len(sys.argv) &gt; 1 else 3.0&#10;    while True:&#10;        st = load_state()&#10;        if st.get("recording"):&#10;            dump_ui_fast()&#10;        time.sleep(interval)&#10;&#10;if __name__ == "__main__":&#10;    main()&#10;&apos;&apos;&apos;)&#10;(ROOT / "tools" / "godmode_watcher.py").chmod(0o755)&#10;&#10;# --- brocc subcommand stub ---&#10;brocc = HOME / "brocc"&#10;if brocc.is_file():&#10;    t = brocc.read_text()&#10;    if "godmode)" not in t and &apos;godmode"&apos; not in t:&#10;        stub = r&apos;&apos;&apos;&#10;godmode)&#10;  exec python3 "$HOME/broccoli_godmode.py" "${@:2}"&#10;  ;;&#10;&apos;&apos;&apos;&#10;        if "case " in t and "esac" in t:&#10;            t = t.replace("esac", stub + "esac", 1)&#10;        else:&#10;            t = t.rstrip() + "\n# brocc godmode -&gt; python3 ~/broccoli_godmode.py\n"&#10;        brocc.write_text(t)&#10;        print("brocc godmode stub added")&#10;    else:&#10;        print("brocc godmode already present")&#10;&#10;# --- TASK godmode phase note ---&#10;taskp = ROOT / "tasks/current/TASK.md"&#10;if taskp.exists():&#10;    tt = taskp.read_text()&#10;    if "godmode" not in tt.lower():&#10;        taskp.write_text(tt.rstrip() + "\n\n## God mode (v0)\n- brocc godmode start while using phone; brocc godmode export → AGI synthesizes automations.\n")&#10;&#10;# --- tap hook note in AUTOMATION_SCOPE ---&#10;scope = ROOT / "AUTOMATION_SCOPE.md"&#10;line = "- God mode v0: UI dump + touch ring + session export for AGI automation synthesis (low-latency packet).\n"&#10;if scope.exists():&#10;    if "God mode v0" not in scope.read_text():&#10;        scope.write_text(scope.read_text().rstrip() + "\n" + line)&#10;else:&#10;    scope.write_text("# scope\n" + line)&#10;&#10;print("godmode v0 installed")&#10;print("start: brocc godmode start")&#10;print("export: brocc godmode export pilot")&#10;END&#10;brocc godmode start&#10;brocc godmode dump&#10;brocc recover&#10;brocc research round 2&gt;/dev/null || true&#10;brocc run-once&#10;brocc report' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,0][1048,163]" /></no