ed="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,0][1048,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,0][1048,1385]"><node index="0" text="" resource-id="" class="android.widget.HorizontalScrollView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[32,0][1048,1385]"><node index="0" text='python3 &lt;&lt; &apos;END&apos;&#10;from pathlib import Path&#10;import re, time&#10;&#10;HOME = Path.home()&#10;ROOT = HOME / "broccoli"&#10;LIB = ROOT / "lib"&#10;LIB.mkdir(parents=True, exist_ok=True)&#10;&#10;( LIB / "suggestion_guard.py" ).write_text(&apos;&apos;&apos;import re&#10;SUGGESTION_PAT = re.compile(&#10;    r"(?i)(suggested|try asking|ask grok|follow.?up|autocomplete|chip|"&#10;    r"prompt suggestion|explore|trending|in.?app suggestion)"&#10;)&#10;def looks_like_suggestions_only(text):&#10;    t = (text or "").strip()&#10;    if not t:&#10;        return False&#10;    if SUGGESTION_PAT.search(t):&#10;        return True&#10;    lines = [ln.strip() for ln in t.splitlines() if ln.strip()]&#10;    if len(lines) &gt;= 2 and all(len(ln) &lt; 48 for ln in lines):&#10;        if "GROK_SMOKE_OK" not in t and "LOOP_OK" not in t and "TASK_COMPLETE" not in t:&#10;            return True&#10;    return False&#10;def is_junk_reply(text, smoke=False):&#10;    t = (text or "").strip()&#10;    if not t or looks_like_suggestions_only(t):&#10;        return True&#10;    if smoke:&#10;        return "GROK_SMOKE_OK" not in t&#10;    return False&#10;&apos;&apos;&apos;)&#10;&#10;( LIB / "capture_retry.py" ).write_text(&apos;&apos;&apos;"""Retry UI capture after scroll; avoid junk/suggestion FAIL spam."""&#10;import time&#10;from pathlib import Path&#10;&#10;def _read_capture():&#10;    p = Path.home() / "broccoli/ui/last_capture.txt"&#10;    if p.exists():&#10;        return p.read_text(errors="replace")&#10;    return ""&#10;&#10;def _scroll_end():&#10;    import subprocess&#10;    for cmd in (&#10;        ["python3", str(Path.home() / "broccoli_bootstrap.py"), "scroll_chat_end"],&#10;        ["brocc", "focus"],&#10;    ):&#10;        try:&#10;            subprocess.run(cmd, timeout=45, capture_output=True)&#10;        except Exception:&#10;            pass&#10;&#10;def capture_with_retries(max_tries=4, sleep_s=0.45):&#10;    try:&#10;        from lib.suggestion_guard import looks_like_suggestions_only, is_junk_reply&#10;    except ImportError:&#10;        from suggestion_guard import looks_like_suggestions_only, is_junk_reply&#10;    last = ""&#10;    for i in range(max_tries):&#10;        if i:&#10;            _scroll_end()&#10;            time.sleep(sleep_s)&#10;            _scroll_end()&#10;            time.sleep(sleep_s)&#10;        # trigger read if bootstrap exposes it&#10;        import subprocess&#10;        boot = Path.home() / "broccoli_bootstrap.py"&#10;        if boot.exists():&#10;            for sub in ("read_reply", "capture_chat", "iterate_capture"):&#10;                try:&#10;                    subprocess.run(["python3", str(boot), sub], timeout=60, capture_output=True)&#10;                except Exception:&#10;                    pass&#10;        last = _read_capture()&#10;        if last.strip() and not looks_like_suggestions_only(last):&#10;            return last&#10;    return last&#10;&apos;&apos;&apos;)&#10;&#10;def patch_file(path, marker, insert_after_line_containing, new_lines):&#10;    if not path.exists():&#10;        return False&#10;    t = path.read_text()&#10;    if marker in t:&#10;        return True&#10;    lines = t.splitlines()&#10;    out = []&#10;    done = False&#10;    for line in lines:&#10;        out.append(line)&#10;        if not done and insert_after_line_containing in line:&#10;            out.extend(new_lines)&#10;            done = True&#10;    if not done:&#10;        out = new_lines + [""] + lines&#10;    path.write_text("\n".join(out) + "\n")&#10;    return True&#10;&#10;# Patch accept / grok_job: before junk fail, use capture_with_retries&#10;candidates = []&#10;for base in [HOME, ROOT]:&#10;    for name in ("broccoli_accept.py", "broccoli_grok_job.py", "broccoli_worker.sh"):&#10;        p = base / name&#10;        if p.exists():&#10;            candidates.append(p)&#10;&#10;HOOK = &apos;&apos;&apos;&#10;# BROCC_CAPTURE_RETRY&#10;try:&#10;    import sys&#10;    from pathlib import Path as _P&#10;    _lib = _P.home() / "broccoli/lib"&#10;    if str(_lib) not in sys.path:&#10;        sys.path.insert(0, str(_lib))&#10;    from capture_retry import capture_with_retries&#10;    from suggestion_guard import looks_like_suggestions_only, is_junk_reply&#10;except Exception:&#10;    capture_with_retries = None&#10;    looks_like_suggestions_only = lambda t: False&#10;&apos;&apos;&apos;&#10;&#10;JUNK_FIX = &apos;&apos;&apos;&#10;    if capture_with_retries and (not reply or not str(reply).strip() or looks_like_suggestions_only(str(reply))):&#10;        reply = capture_with_retries()&#10;    if looks_like_suggestions_only(str(reply or "")):&#10;        raise RuntimeError("retry_capture_suggestions")&#10;&apos;&apos;&apos;&#10;&#10;for p in candidates:&#10;    if p.suffix == ".py":&#10;        t = p.read_text()&#10;        if "BROCC_CAPTURE_RETRY" not in t:&#10;            t = HOOK + t&#10;        if "retry_capture_suggestions" not in t and "junk reply" in t:&#10;            t = t.replace(&#10;                &apos;fail("junk reply")&apos;,&#10;                JUNK_FIX.strip() + &apos;\n    fail("junk reply")&apos;,&#10;                1,&#10;            )&#10;            t = t.replace(&#10;                &apos;"junk reply"&apos;,&#10;                &apos;"retry_capture_suggestions" if looks_like_suggestions_only(str(reply or "")) else "junk reply"&apos;,&#10;                1,&#10;            )&#10;        p.write_text(t)&#10;        print("patched", p)&#10;&#10;# Worker: prefer google when TASK provider google and grok not required&#10;wp = ROOT / "broccoli_worker.sh"&#10;if not wp.exists():&#10;    wp = HOME / "broccoli_worker.sh"&#10;if wp.exists():&#10;    wt = wp.read_text()&#10;    if "BROCC_GOOGLE_FIRST" not in wt:&#10;        snippet = &apos;&apos;&apos;&#10;# BROCC_GOOGLE_FIRST&#10;if [ -f "$HOME/broccoli/tasks/current/TASK.md" ] &amp;&amp; grep -q &apos;^provider: google&apos; "$HOME/broccoli/tasks/current/TASK.md" 2&gt;/dev/null; then&#10;  brocc research round 2&gt;/dev/null || python3 "$HOME/broccoli_research.py" round 2&gt;/dev/null || true&#10;fi&#10;&apos;&apos;&apos;&#10;        wp.write_text(snippet + wt)&#10;        print("patched", wp)&#10;&#10;print("capture_retry installed")&#10;END&#10;brocc recover&#10;brocc resume 2&gt;/dev/null || true&#10;brocc smoke --force&#10;brocc research round 2&gt;/dev/null || python3 ~/broccoli_research.py round 2&gt;/dev/null || true&#10;brocc run-once&#10;brocc report' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checke