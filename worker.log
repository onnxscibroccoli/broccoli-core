ed="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,0][1048,1227]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,0][1048,201]"><node index="0" text="" resource-id="" class="android.widget.HorizontalScrollView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[32,0][1048,201]"><node index="0" text='export PATH="$HOME:$PATH"&#10;python3 &lt;&lt; &apos;END&apos;&#10;from pathlib import Path&#10;import json, os&#10;&#10;H = Path.home()&#10;R = H / "broccoli"&#10;for d in ("user", "tasks/current", "ui", "thread", "reports"):&#10;    (R / d).mkdir(parents=True, exist_ok=True)&#10;(R / "user" / "PENDING.md").write_text("")&#10;&#10;cal = H / ".grok_ui_cal.json"&#10;if not cal.is_file() or "send" not in cal.read_text():&#10;    cal.write_text(json.dumps({"send": [1001, 1338], "composer": [540, 2200]}, indent=2))&#10;&#10;(H / "broccoli_accept.py").write_text("""#!/usr/bin/env python3&#10;import subprocess, sys&#10;from pathlib import Path&#10;R = Path.home() / "broccoli"&#10;def run(cmd):&#10;    return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=180)&#10;ok, msgs = True, []&#10;r = run("python3 ~/broccoli_bootstrap.py grok-smoke 2&gt;&amp;1 | tail -8")&#10;out = (r.stdout or "") + (r.stderr or "")&#10;if "PASS" not in out and "GROK_SMOKE_OK" not in out:&#10;    ok = False; msgs.append("grok-smoke fail")&#10;else:&#10;    msgs.append("grok-smoke ok")&#10;r = run("python3 ~/broccoli_ui.py ensure 2&gt;&amp;1 | tail -3")&#10;if &apos;"send"&apos; not in (r.stdout or "") and "1001" not in (r.stdout or ""):&#10;    ok = False; msgs.append("ui send missing")&#10;else:&#10;    msgs.append("ui ok")&#10;rep = (R / "reports" / "latest.txt").read_text(errors="replace") if (R / "reports/latest.txt").is_file() else ""&#10;if rep.count("=== BROCCOLI REPORT ===") &gt; 1:&#10;    ok = False; msgs.append("nested report")&#10;elif "(empty reply)" in rep or rep.strip().endswith("reply: \\n"):&#10;    ok = False; msgs.append("empty reply in report")&#10;else:&#10;    msgs.append("report ok")&#10;s = "; ".join(msgs)&#10;if ok:&#10;    print("TASK_COMPLETE: " + s)&#10;    subprocess.run([sys.executable, str(H / "broccoli_task.py"), "complete", s], check=False)&#10;else:&#10;    print("TASK_INCOMPLETE: " + s)&#10;    sys.exit(1)&#10;""")&#10;os.chmod(H / "broccoli_accept.py", 0o755)&#10;&#10;(H / "broccoli_clean_stdout.py").write_text("""#!/usr/bin/env python3&#10;import sys&#10;r = (sys.stdin.read() or "").strip()&#10;if "=== BROCCOLI REPORT ===" in r:&#10;    r = r.split("=== BROCCOLI REPORT ===")[0].strip()&#10;if "&lt;?xml" in r:&#10;    r = r.split("&lt;?xml")[0].strip()&#10;print(r[:2000] if r else "")&#10;""")&#10;os.chmod(H / "broccoli_clean_stdout.py", 0o755)&#10;&#10;(H / "broccoli_reply_ok.py").write_text("""#!/usr/bin/env python3&#10;import sys, re&#10;t = (sys.stdin.read() or "").strip()&#10;junk = re.compile(r"^(Thoughts?|Thinking\\.?|Ask anything)$", re.I)&#10;if len(t) &lt; 12 or junk.match(t):&#10;    sys.exit(1)&#10;print(t)&#10;""")&#10;os.chmod(H / "broccoli_reply_ok.py", 0o755)&#10;&#10;(H / "broccoli_report.py").write_text("""#!/usr/bin/env python3&#10;import sys, subprocess, time&#10;from pathlib import Path&#10;ROOT = Path.home() / "broccoli"&#10;def clean_reply(r):&#10;    r = (r or "").strip()&#10;    if not r: return "(empty reply)"&#10;    if "&lt;?xml" in r: r = r.split("&lt;?xml")[0].strip()&#10;    if "=== BROCCOLI REPORT ===" in r: r = r.split("=== BROCCOLI REPORT ===")[0].strip()&#10;    skip = ("STEP ", "time:", "provider:", "job:", "status:", "reply:", "extra:", "log:")&#10;    lines = [ln for ln in r.splitlines() if not any(ln.strip().startswith(x) for x in skip) and "=== BROCCOLI" not in ln]&#10;    r = "\\n".join(lines).strip()&#10;    return r[:2000] if r else "(empty reply)"&#10;def finish(provider, job, status, reply="", extra=""):&#10;    ts = time.strftime("%Y-%m-%d %H:%M:%S")&#10;    body = "\\n".join(["=== BROCCOLI REPORT ===", "time: "+ts, "provider: "+provider,&#10;        "job: "+job, "status: "+status, "reply: "+clean_reply(reply), "extra: "+(extra or "")[:800],&#10;        "log: ~/broccoli/daemon.log", "=== END REPORT ==="])&#10;    (ROOT/"reports/latest.txt").write_text(body)&#10;    (ROOT/"LAST_RUN.txt").write_text("%s %s %s\\n" % (provider, status, job))&#10;    print(body, flush=True)&#10;    subprocess.run(["termux-clipboard-set"], input=body.encode(), timeout=8, check=False)&#10;    subprocess.run(["termux-toast","-s","Broccoli %s %s"%(status, job[:35])], timeout=5, check=False)&#10;if __name__=="__main__":&#10;    finish(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv)&gt;4 else "")&#10;""")&#10;os.chmod(H / "broccoli_report.py", 0o755)&#10;&#10;compose = H / "broccoli_compose.py"&#10;extra_rules = [&#10;    "FORBIDDEN: Thoughts-only or empty reply — always NEXT_STEP + TERMINUX + TEST + REPORT_FOR_MAC.",&#10;    "TERMINUX: raw python3 &lt;&lt; only, no markdown fences.",&#10;]&#10;if compose.is_file():&#10;    t = compose.read_text()&#10;    if "USER RE-ENTRY" not in t:&#10;        t = t.replace(&#10;            &apos;    prompt = "\\n".join([&apos;,&#10;            &apos;    pending = read(ROOT / "user" / "PENDING.md", 1500) or "(none)"\n    task = read(ROOT / "tasks" / "current" / "TASK.md", 2000) or "(no TASK)"\n    prompt = "\\n".join([&apos;,&#10;            1,&#10;        )&#10;        t = t.replace(&#10;            &apos;"=== BROCCOLI CONTEXT ===",&apos;,&#10;            &apos;"=== USER RE-ENTRY ===", pending, "", "=== TASK ===", task, "", "=== BROCCOLI CONTEXT ===",&apos;,&#10;            1,&#10;        )&#10;    for rule in extra_rules:&#10;        if rule not in t:&#10;            t = t.replace(&apos;"=== RULES ===",&apos;, &apos;"=== RULES ===",\n        "%s",&apos; % rule, 1)&#10;    compose.write_text(t)&#10;&#10;bp = H / "broccoli_bootstrap.py"&#10;s = bp.read_text()&#10;scroll = &apos;&apos;&apos;&#10;def scroll_chat_end(n=3):&#10;    import time as _t&#10;    for i in range(n):&#10;        log("scroll_chat_end", i + 1)&#10;        shizuku_cmd("input swipe 540 1700 540 700 280")&#10;        _t.sleep(0.4)&#10;&apos;&apos;&apos;&#10;if "def scroll_chat_end" not in s:&#10;    s = s.replace("def grok_ask", scroll + "\ndef grok_ask", 1)&#10;if "scroll_chat_end(3)" not in s and "reply = last_reply" in s:&#10;    s = s.replace(&#10;        "reply = last_reply",&#10;        "import time as _tw\n        for _w in range(12):\n            _tw.sleep(5)\n            scroll_chat_end(2)\n            reply = last_reply()\n            if reply and len(reply.strip()) &gt;= 12:\n                break\n        if not reply or len((reply or &apos;&apos;).strip()) &lt; 12:\n            reply = &apos;&apos;",&#10;        1,&#10;    )&#10;bp.write_text(s)&#10;&#10;w = H / "broccoli_worker.sh"&#10;txt = w.read_text()&#10;if "broccoli_reply_ok.py" not in txt:&#10;    txt = txt.replace(&#10;        &apos;if raw=$(python3 "$GROK" grok-ask "$prompt" 2&gt;&gt;"$LOG"); then&apos;,&#10;        &apos;if raw=$(python3 "$GROK" grok-ask "$prompt" 2&gt;&gt;"$LOG"); then\n    reply=$(printf "%s" "$raw" | python3 "$HOME/broccoli_clean_stdout.py" | python3 "$HOME/broccoli_reply_ok.py" 2&gt;/dev/null) || { mv "$job" "$ROOT/fail/$n" 2&gt;/dev/null; python3 "$REP" grok "$n" FAIL "empty or junk reply" 2&gt;/dev/null; continue; }&apos;,&#10;    )&#10;    if &apos;if reply=$(python3 "$GROK"&apos; in txt:&#10;        txt = txt.replace(&#10;            &apos;if reply=$(python3 "$GROK" grok-ask "$prompt" 2&gt;&gt;"$LOG"); then&apos;,&#10;            &apos;if raw=$(python3 "$GROK" grok-ask "$prompt" 2&gt;&gt;"$LOG"); then\n    reply=$(printf "%s" "$raw" | python3 "$HOME/broccoli_clean_stdout.py" | python3 "$HOME/broccoli_reply_ok.py" 2&gt;/dev/null) || { echo "junk reply" &gt;&gt;"$LOG"; mv "$job" "$ROOT/fail/$n"; python3 "$REP" grok "$n" FAIL "junk reply"; continue; }&apos;,&#10;        )&#10;if "broccoli_accept.py" not in txt:&#10;    txt = txt.replace(&#10;        &apos;termux-toast -s "Broccoli: idle"&apos;,&#10;        &apos;python3 "$HOME/broccoli_accept.py" 2&gt;&gt;"$LOG" | tee -a "$LOG" || true\ntermux-toast -s "Broccoli: idle"&apos;,&#10;        1,&#10;    )&#10;w.write_text(txt)&#10;&#10;(H / "brocc").write_text("""#!/data/data/com.termux/files/usr/bin/bash&#10;ROOT="$HOME/broccoli"&#10;case "${1:-}" in&#10;start)&#10;  if [ -f "$ROOT/daemon.pid" ] &amp;&amp; kill -0 "$(cat "$ROOT/daemon.pid")" 2&gt;/dev/null; then echo RUNNING "$(cat "$ROOT/daemon.pid")"; exit 0; fi&#10;  nohup "$HOME/broccoli-daemon.sh" &gt;&gt; "$ROOT/daemon.log" 2&gt;&amp;1 &amp; echo started $! ;;&#10;stop) [ -f "$ROOT/daemon.pid" ] &amp;&amp; kill "$(cat "$ROOT/daemon.pid")" 2&gt;/dev/null; rm -f "$ROOT/daemon.pid" ;;&#10;status)&#10;  [ -f "$ROOT/daemon.pid" ] &amp;&amp; kill -0 "$(cat "$ROOT/daemon.pid")" 2&gt;/dev/null &amp;&amp; echo RUNNING "$(cat "$ROOT/daemon.pid")" || echo STOPPED&#10;  ls "$ROOT/inbox/grok" 2&gt;/dev/null; cat "$ROOT/LAST_RUN.txt" 2&gt;/dev/null ;;&#10;task) python3 "$HOME/broccoli_task.py" "${2:-status}" "${3:-}" ;;&#10;inject) shift; echo "$*" &gt; "$ROOT/user/PENDING.md"; termux-toast -s "user inject" 2&gt;/dev/null; echo ok ;;&#10;pause) python3 -c "import json;from pathlib import Path as P;p=P.home()/&apos;broccoli/tasks/state.json&apos;;d=json.loads(p.read_text()) if p.is_file() else {};d[&apos;status&apos;]=&apos;PAUSED&apos;;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(d))"; termux-toast -s PAUSED 2&gt;/dev/null ;;&#10;resume) python3 -c "import json;from pathlib import Path as P;p=P.home()/&apos;broccoli/tasks/state.json&apos;;d=json.loads(p.read_text()) if p.is_file() else {};d[&apos;status&apos;]=&apos;RUNNING&apos;;p.write_text(json.dumps(d))"; termux-toast -s RUNNING 2&gt;/dev/null ;;&#10;log) tail -n "${2:-50}" "$ROOT/daemon.log" ;;&#10;report) cat "$ROOT/reports/latest.txt"; termux-clipboard-set &lt; "$ROOT/reports/latest.txt" 2&gt;/dev/null ;;&#10;ask) p="${2:-grok}"; shift 2; f="$ROOT/inbox/$p/$(date +%s).txt"; printf &apos;%s\\n&apos; "$*" &gt; "$f"; echo queued "$f" ;;&#10;run-once) "$HOME/broccoli_worker.sh" ;;&#10;*) echo "brocc start|stop|status|task|inject|pause|resume|log|report|ask|run-once" ;;&#10;esac&#10;""")&#10;os.chmod(H / "brocc", 0o755)&#10;&#10;(R / "thread" / "conversation.md").write_text("# Broccoli thread\\n\\n")&#10;print("END OK")&#10;END&#10;&#10;python3 -m py_compile ~/broccoli_bootstrap.py ~/broccoli_accept.py ~/broccoli_report.py &amp;&amp; echo COMPILE_OK&#10;python3 ~/broccoli_ui.py cal-only | head -5&#10;brocc inject "User interjection: scroll chat before read; empty reply must FAIL and retry"&#10;brocc ask grok "NEXT_STEP one line. TERMINUX: echo READY. TEST: echo OK. REPORT_FOR_MAC: 4 lines. Min 80 chars in reply."&#10;brocc run-once&#10;brocc report' resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable