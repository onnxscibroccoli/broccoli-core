&lt;script&gt;
/* =========================
   STORAGE KEYS
========================= */
const STORAGE_TEXT = &quot;spritz_text&quot;;
const STORAGE_INDEX = &quot;spritz_index&quot;;
const STORAGE_WPM = &quot;spritz_wpm&quot;;

/* =========================
   DEFAULT TEXT
========================= */
const DEFAULT_TEXT = `Welcome to the Spritz-style speed reader.

Paste any text here — an article, a chapter, or an entire book.

Your reading position, speed, and text are saved automatically.
You can close the browser and resume exactly where you left off.

Tap once to start or pause.
Double tap to restart from the beginning.`;

/* =========================
   ELEMENTS
========================= */
const textInput = document.getElementById(&quot;textInput&quot;);
const wordContainer = document.getElementById(&quot;wordContainer&quot;);
const progress = document.getElementById(&quot;progress&quot;);
const slider = document.getElementById(&quot;wpmSlider&quot;);
const wpmValue = document.getElementById(&quot;wpmValue&quot;);

/* =========================
   STATE
========================= */
let words = [];
let index = 0;
let timer = null;
let state = &quot;IDLE&quot;;
let lastTap = 0;
