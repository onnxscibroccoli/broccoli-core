  width: 60px;
  text-align: right;
  font-weight: 600;
}

button {
  background: #1c1c1c;
  color: #fff;
  border: none;
  border-radius: 10px;
  padding: 8px 12px;
  font-size: 16px;
}

.hint {
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 4px;
}

.reader {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  user-select: none;
}

.word-container {
  width: 90%;
  max-height: 80%;
  overflow-y: auto;
  line-height: 1.5;
  text-align: center;
  font-size: 24px;
}

.word-span {
  cursor: pointer;
  padding: 2px 1px;
  white-space: pre-wrap;
}

.current-word {
  color: var(--accent);
  font-weight: 700;
}

.progress-container {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 6px;
  background: #222;
}

.progress {
  height: 100%;
  width: 0%;
  background: var(--accent);
}
&lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;

&lt;textarea id=&quot;textInput&quot;&gt;&lt;/textarea&gt;

&lt;div class=&quot;controls&quot;&gt;
  &lt;label&gt;WPM&lt;/label&gt;
  &lt;input type=&quot;range&quot; id=&quot;wpmSlider&quot; min=&quot;100&quot; max=&quot;1500&quot; step=&quot;5&quot;&gt;
  &lt;div class=&quot;wpm&quot; id=&quot;wpmValue&quot;&gt;&lt;/div&gt;
  &lt;button onclick=&quot;toggleFullscreen()&quot;&gt;⛶&lt;/button&gt;
&lt;/div&gt;

&lt;div class=&quot;hint&quot;&gt;Tap = play / pause • Double tap = restart • Click a word to start from there&lt;/div&gt;

&lt;div class=&quot;reader&quot;&gt;
  &lt;div class=&quot;word-container&quot; id=&quot;wordContainer&quot;&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;div class=&quot;progress-container&quot;&gt;
  &lt;div class=&quot;progress&quot; id=&quot;progress&quot;&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
/* =========================
   STORAGE KEYS
========================= */
const STORAGE_TEXT = &quot;spritz_text&quot;;
const STORAGE_INDEX = &quot;spritz_index&quot;;
const STORAGE_WPM = &quot;spritz_wpm&quot;;

/* =========================
   DEFAULT TEXT
========================= */
const DEFAULT_TEXT = `Welcome to the Spritz-style speed reader.

Paste any text here — an article, a chapter, or an entire book.

Your reading position, speed, and text are saved automatically.
You can close the browser and resume exactly where you left off.

Tap once to start or pause.
Double tap to restart from the beginning.`;

/* =========================
   ELEMENTS
========================= */
const textInput = document.getElementById(&quot;textInput&quot;);
const wordContainer = document.getElementById(&quot;wordContainer&quot;);
const progress = document.getElementById(&quot;progress&quot;);
const slider = document.getElementById(&quot;wpmSlider&quot;);
const wpmValue = document.getElementById(&quot;wpmValue&quot;);

/* =========================
   STATE
========================= */
let words = [];
let index = 0;
let timer = null;
let state = &quot;IDLE&quot;;
let lastTap = 0;
let wpm = 555;
let demoActive = false;

/* =========================
   INIT (RESTORE)
========================= */
const savedText = localStorage.getItem(STORAGE_TEXT);
const savedIndex = localStorage.getItem(STORAGE_INDEX);
const savedWpm = localStorage.getItem(STORAGE_WPM);

if (savedText) {
  textInput.value = savedText;
  index = savedIndex ? Number(savedIndex) : 0;
} else {
  textInput.value = DEFAULT_TEXT;
  demoActive = true;
}

if (savedWpm) wpm = Number(savedWpm);

slider.value = wpm;
wpmValue.textContent = wpm;

/* =========================
   TEXT INPUT HANDLING
========================= */
textInput.addEventListener(&quot;focus&quot;, () =&gt; {
  if (demoActive) {
    textInput.value = &quot;&quot;;
    demoActive = false;
  }
});

textInput.addEventListener(&quot;input&quot;, () =&gt; {
  localStorage.setItem(STORAGE_TEXT, textInput.value);
});

/* =========================
   WPM CONTROL
========================= */
slider.addEventListener(&quot;input&quot;, () =&gt; {
  wpm = Number(slider.value);
  wpmValue.textContent = wpm;
  localStorage.setItem(STORAGE_WPM, wpm);
});

/* =========================
   TEXT LOAD
========================= */
function loadText() {
  words = textInput.value.trim().split(/\s+/);
  renderPausedText();
  updateProgress();
}

/* =========================
   ORP
========================= */
function getORPIndex(word) {
  if (word.length &lt;= 1) return 0;
  if (word.length &lt;= 5) return 1;
  if (word.length &lt;= 9) return 2;
  return 3;
}

function formatWordSpan(word, i) {
  const orpIndex = getORPIndex(word);
  const left = word.slice(0, orpIndex);
  const orp = word[orpIndex] || &quot;&quot;;
  const right = word.slice(orpIndex + 1);
  return `&lt;span class=&quot;word-span&quot; data-index=&quot;${i}&quot;&gt;
      &lt;span class=&quot;left&quot;&gt;${left}&lt;/span&gt;&lt;span class=&quot;orp&quot;&gt;${orp}&lt;/span&gt;&lt;span class=&quot;right&quot;&gt;${right}&lt;/span&gt;
    &lt;/span&gt;`;
}

/* =========================
   RENDER PAUSED SCROLLABLE TEXT
========================= */
function renderPausedText() {
  wordContainer.innerHTML = words.map((w, i) =&gt; {
    return `&lt;span class=&quot;word-span ${i === index ? &#39;current-word&#39; : &#39;&#39;}&quot; data-index=&quot;${i}&quot;&gt;${w}&lt;/span&gt;`;
  }).join(&#39; &#39;);
}

/* =========================
   TIMING
========================= */
function getDelay(word) {
  let delay = 60000 / wpm;
  if (/[,.]/.test(word)) delay *= 1.5;
  if (/[!?]/.test(word)) delay *= 2;
  return delay;
}

/* =========================
   LOOP
========================= */
function tick() {
  if (index &gt;= words.length) {
    pause();
    return;
  }

  const currentWord = words[index];
  renderRunningWord(currentWord);

  updateProgress();
  localStorage.setItem(STORAGE_INDEX, index);

  index++;
  timer = setTimeout(tick, getDelay(currentWord));
}

function renderRunningWord(word) {
  const i = index;
  wordContainer.innerHTML = formatWordSpan(word, i);
  // Scroll current word into view
  const el = wordContainer.querySelector(&#39;.current-word&#39;);
  if (el) el.scrollIntoView({ behavior: &#39;auto&#39;, block: &#39;center&#39; });
}

/* =========================
   CONTROLS
========================= */
function start() {
  if (state === &quot;IDLE&quot;) loadText();
  if (!words.length) return;
  state = &quot;RUNNING&quot;;
  tick();
}

function pause() {
  clearTimeout(timer);
  state = &quot;PAUSED&quot;;
  renderPausedText();
}

function restart() {
  clearTimeout(timer);
  index = 0;
  localStorage.setItem(STORAGE_INDEX, 0);
  loadText();
  state = &quot;IDLE&quot;;
  start();
}

/* =========================
   TAP HANDLING
========================= */
document.body.addEventListener(&quot;click&quot;, () =&gt; {
  const now = Date.now();
  if (now - lastTap &lt; 300) {
    restart();
  } else {
    state === &quot;RUNNING&quot; ? pause() : start();
  }
  lastTap = now;
});

/* =========================
   WORD CLICK NAVIGATION
========================= */
wordContainer.addEventListener(&quot;click&quot;, (e) =&gt; {
  const target = e.target.closest(&quot;.word-span&quot;);
  if (!target) return;
  const newIndex = Number(target.dataset.index);
  if (!isNaN(newIndex)) {
    index = newIndex;
    localStorage.setItem(STORAGE_INDEX, index);
    start();
  }
});

/* =========================
   FULLSCREEN
========================= */
function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen();
  } else {
    document.exitFullscreen();
  }
}

/* =========================
   PROGRESS
========================= */
function updateProgress() {
  progress.style.width = ((index + 1) / words.length) * 100 + &quot;%&quot;;
}

/* =========================
   INIT
========================= */
loadText();
&lt;/script&gt;

&lt;/body&gt;
&lt;/html&gt;Perfect — I see exactly what you’re aiming for: a long-form reading experience with both contextual pausing and persistent state, but now with selectable navigation inside the text itself. We can absolutely extend your current foundation to make the paused text scrollable and allow long-tap or click-to-start from a specific word.

Here’s the plan for the next layer:


---

1️⃣ Scrollable paused text

When paused:

Instead of showing only the pre/post context as tiny snippets, the entire paragraph (or a reasonable text window) is rendered above and below the focal word.

Make this container scrollable (overflow-y: auto) so the user can browse the text in context while paused.


Ensure the current ORP word stays fixed in the viewport — like a “focal anchor.”

Smooth scroll optional for UX polish.



---

2️⃣ Long-tap / click-to-start from selected word

Each word in the rendered text (paused state) will be clickable.

When a user long-press or double-clicks a word:

Set index to that word’s position in the full text.

Resume reading from that word.


Can optionally highlight the word while pressing to indicate selection.



---

3️⃣ UX details

Keep demo vs. user text logic as is.

Preserve all localStorage behavior.

Only modify paused state rendering and word selection logic.

Make sure progress bar and ORP focus update correctly after a manual jump.



---

If you want, I can rewrite your HTML+JS to integrate this scrollable paused text with click-to-start navigation, keeping everything else intact, so you get a single-file production-ready reader that’s book-grade and interactive.

Do you want me to do that next?So one thing that it seems you have conflicting instructions is for the fixed position of the current word when scrolling that&#39;s contradictory whole text needs to scroll including current word but the color and other style aspects can be preserved as to let the reader know where they werePerfect — let’s turn this into a full production-ready upgrade. I’ll integrate:

Scrollable paused text (entire text scrolls)

Current word highlighting (ORP accent, bold, etc.)

Click / long-tap to start from any word

Preserve all localStorage behavior and WPM settings


Everything remains single-file, mobile-friendly, and book-grade.

