<hr>
<h3>📄 Complete Production Code</h3>
<pre><code>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
    &lt;meta charset=&quot;UTF-8&quot;&gt;
    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0, user-scalable=no&quot;&gt;
    &lt;title&gt;Spritz Pro Reader&lt;/title&gt;

    &lt;style&gt;
        :root {
            --bg: #0b0b0b;
            --fg: #ffffff;
            --muted: #8a8a8a;
            --accent: #ff3b3b;
            --surface: #1c1c1c;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--fg);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 100vh;
            overflow: hidden;
            touch-action: manipulation;
        }

        textarea {
            width: 94%;
            height: 100px;
            margin-top: 10px;
            padding: 12px;
            font-size: 15px;
            background: var(--surface);
            color: var(--fg);
            border-radius: 12px;
            border: 1px solid #333;
            resize: none;
        }

        .controls {
            width: 94%;
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 10px 0;
        }

        .controls label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }

        input[type=&quot;range&quot;] { flex: 1; accent-color: var(--accent); }

        .wpm { width: 50px; text-align: right; font-weight: 700; color: var(--accent); }

        button {
            background: var(--surface);
            color: #fff;
            border: 1px solid #333;
            border-radius: 10px;
            padding: 8px 16px;
            font-size: 16px;
            cursor: pointer;
        }

        .hint { font-size: 12px; color: var(--muted); margin-bottom: 8px; }

        .reader-viewport {
            flex: 1;
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        /* RUNNING STATE: Large single word focus */
        #spritz-display {
            display: none;
            font-size: 48px;
            font-weight: 500;
            pointer-events: none;
        }

        .orp { color: var(--accent); }

        /* PAUSED STATE: Full text scroll */
        #scroll-display {
            width: 100%;
            height: 100%;
            overflow-y: auto;
            padding: 40px 5%;
            text-align: center;
            line-height: 1.8;
            font-size: 20px;
            display: block;
            mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
        }

        .word-token {
            display: inline-block;
            margin: 0 4px;
            cursor: pointer;
            color: var(--muted);
            transition: color 0.2s;
        }

        .word-token.active {
            color: var(--accent);
            font-weight: 800;
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .progress-container {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #222;
        }

        .progress-bar { height: 100%; width: 0%; background: var(--accent); transition: width 0.1s linear; }
    &lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;

&lt;textarea id=&quot;textInput&quot; placeholder=&quot;Paste your book or article here...&quot;&gt;&lt;/textarea&gt;

&lt;div class=&quot;controls&quot;&gt;
    &lt;label&gt;WPM&lt;/label&gt;
    &lt;input type=&quot;range&quot; id=&quot;wpmSlider&quot; min=&quot;100&quot; max=&quot;1200&quot; step=&quot;10&quot;&gt;
    &lt;div class=&quot;wpm&quot; id=&quot;wpmDisplay&quot;&gt;555&lt;/div&gt;
    &lt;button onclick=&quot;toggleFullscreen()&quot;&gt;⛶&lt;/button&gt;
&lt;/div&gt;

&lt;div class=&quot;hint&quot;&gt;Tap background to toggle play • Tap word to jump&lt;/div&gt;

&lt;div class=&quot;reader-viewport&quot; id=&quot;viewport&quot;&gt;
    &lt;div id=&quot;spritz-display&quot;&gt;&lt;/div&gt;
    
    &lt;div id=&quot;scroll-display&quot;&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;div class=&quot;progress-container&quot;&gt;
    &lt;div class=&quot;progress-bar&quot; id=&quot;progressBar&quot;&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
    const STORAGE_KEY_TEXT = &quot;spritz_user_text&quot;;
    const STORAGE_KEY_IDX = &quot;spritz_current_idx&quot;;
    const STORAGE_KEY_WPM = &quot;spritz_speed&quot;;

    const DEFAULT_TEXT = &quot;Welcome to your pro speed reader. Paste any text into the box above to begin. When you pause, you can scroll through the entire text and click any word to resume reading from that exact spot. Your progress is saved automatically.&quot;;

    let words = [];
    let index = 0;
    let wpm = 500;
    let timer = null;
    let isRunning = false;
    let lastTap = 0;

    const textInput = document.getElementById(&#39;textInput&#39;);
    const wpmSlider = document.getElementById(&#39;wpmSlider&#39;);
    const wpmDisplay = document.getElementById(&#39;wpmDisplay&#39;);
    const spritzDisplay = document.getElementById(&#39;spritz-display&#39;);
    const scrollDisplay = document.getElementById(&#39;scroll-display&#39;);
    const progressBar = document.getElementById(&#39;progressBar&#39;);

    // 1. Initialize
    function init() {
        const savedText = localStorage.getItem(STORAGE_KEY_TEXT) || DEFAULT_TEXT;
        const savedIdx = localStorage.getItem(STORAGE_KEY_IDX) || 0;
        const savedWpm = localStorage.getItem(STORAGE_KEY_WPM) || 500;

        textInput.value = savedText;
        index = parseInt(savedIdx);
        wpm = parseInt(savedWpm);
        
        wpmSlider.value = wpm;
        wpmDisplay.innerText = wpm;

        processText();
        showPausedState();
    }

    // 2. Process Text into array
    function processText() {
        const rawText = textInput.value.trim();
        words = rawText.split(/\s+/);
        if (index &gt;= words.length) index = 0;
        updateProgress();
    }

    // 3. Spritz ORP Logic
    function getORP(word) {
        const len = word.length;
        if (len &lt;= 1) return 0;
        if (len &lt;= 5) return 1;
        if (len &lt;= 9) return 2;
        return 3;
    }

    function renderSpritzWord(word) {
        const pivot = getORP(word);
        const left = word.slice(0, pivot);
        const mid = word[pivot];
        const right = word.slice(pivot + 1);
        spritzDisplay.innerHTML = `${left}&lt;span class=&quot;orp&quot;&gt;${mid}&lt;/span&gt;${right}`;
    }

    // 4. Paused State (Scrollable)
    function showPausedState() {
        isRunning = false;
        clearTimeout(timer);
        
        spritzDisplay.style.display = &#39;none&#39;;
        scrollDisplay.style.display = &#39;block&#39;;
        
        // Render full text with spans
        scrollDisplay.innerHTML = words.map((w, i) =&gt; `
            &lt;span class=&quot;word-token ${i === index ? &#39;active&#39; : &#39;&#39;}&quot; data-idx=&quot;${i}&quot;&gt;${w}&lt;/span&gt;
        `).join(&#39; &#39;);

        // Scroll current word to center
        setTimeout(() =&gt; {
            const activeEl = scrollDisplay.querySelector(&#39;.active&#39;);
            if (activeEl) {
                activeEl.scrollIntoView({ behavior: &#39;smooth&#39;, block: &#39;center&#39; });
            }
        }, 50);
    }

    // 5. Running State
    function showRunningState() {
        if (index &gt;= words.length) index = 0;
        isRunning = true;
        scrollDisplay.style.display = &#39;none&#39;;
        spritzDisplay.style.display = &#39;block&#39;;
        tick();
    }

    function tick() {
        if (!isRunning || index &gt;= words.length) {
            showPausedState();
            return;
        }

        const word = words[index];
        renderSpritzWord(word);
        updateProgress();
        
        // Save state
        localStorage.setItem(STORAGE_KEY_IDX, index);

        // Timing calculation
        let delay = 60000 / wpm;
        if (word.includes(&#39;.&#39;) || word.includes(&#39;!&#39;) || word.includes(&#39;?&#39;)) delay *= 2;
        else if (word.includes(&#39;,&#39;) || word.includes(&#39;;&#39;) || word.includes(&#39;:&#39;)) delay *= 1.5;

        index++;
        timer = setTimeout(tick, delay);
    }

    function updateProgress() {
        const p = ((index) / words.length) * 100;
        progressBar.style.width = `${p}%`;
    }

    // 6. Interaction Listeners
    scrollDisplay.addEventListener(&#39;click&#39;, (e) =&gt; {
        if (e.target.classList.contains(&#39;word-token&#39;)) {
            index = parseInt(e.target.dataset.idx);
            showRunningState();
            e.stopPropagation();
        }
    });

    document.getElementById(&#39;viewport&#39;).addEventListener(&#39;click&#39;, () =&gt; {
        const now = Date.now();
        if (now - lastTap &lt; 300) {
            index = 0;
            showPausedState();
        } else {
            isRunning ? showPausedState() : showRunningState();
        }
        lastTap = now;
    });

    wpmSlider.addEventListener(&#39;input&#39;, () =&gt; {
        wpm = wpmSlider.value;
        wpmDisplay.innerText = wpm;
        localStorage.setItem(STORAGE_KEY_WPM, wpm);
    });

    textInput.addEventListener(&#39;input&#39;, () =&gt; {
        processText();
        localStorage.setItem(STORAGE_KEY_TEXT, textInput.value);
        if (!isRunning) showPausedState();
    });

    function toggleFullscreen() {
        if (!document.fullscreenElement) document.documentElement.requestFullscreen();
        else document.exitFullscreen();
    }

    init();
&lt;/script&gt;

&lt;/body&gt;
&lt;/html&gt;
</code></pre>
