}

textarea {
  width: 94%;
  height: 120px;
  margin-top: 10px;
  padding: 12px;
  font-size: 15px;
  border-radius: 12px;
  border: none;
  resize: none;
}

.controls {
  width: 94%;
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 10px 0;
}

.controls label {
  font-size: 14px;
  color: var(--muted);
}

