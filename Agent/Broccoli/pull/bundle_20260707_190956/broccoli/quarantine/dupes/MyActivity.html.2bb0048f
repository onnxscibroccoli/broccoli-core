  text-align: center;
  line-height: 1.4;
}

.word {
  display: flex;
  align-items: center;
  font-size: 56px;
  margin: 10px 0;
}

.left {
  min-width: 120px;
  text-align: right;
}

.orp {
  color: var(--accent);
  padding: 0 4px;
}

.right {
  min-width: 120px;
  text-align: left;
}

.progress-container {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 6px;
  background: #222;
}

.progress {
  height: 100%;
  width: 0%;
  background: var(--accent);
}
&lt;/style&gt;
&lt;/head&gt;

&lt;body&gt;

&lt;textarea id=&quot;textInput&quot;&gt;&lt;/textarea&gt;

&lt;div class=&quot;controls&quot;&gt;
  &lt;label&gt;WPM&lt;/label&gt;
  &lt;input type=&quot;range&quot; id=&quot;wpmSlider&quot; min=&quot;100&quot; max=&quot;1500&quot; step=&quot;5&quot;&gt;
  &lt;div class=&quot;wpm&quot; id=&quot;wpmValue&quot;&gt;&lt;/div&gt;
  &lt;button onclick=&quot;toggleFullscreen()&quot;&gt;⛶&lt;/button&gt;
&lt;/div&gt;

&lt;div class=&quot;hint&quot;&gt;Tap = play / pause • Double tap = restart&lt;/div&gt;

&lt;div class=&quot;reader&quot;&gt;
  &lt;div class=&quot;context&quot; id=&quot;preContext&quot;&gt;&lt;/div&gt;
  &lt;div id=&quot;word&quot;&gt;&lt;/div&gt;
  &lt;div class=&quot;context&quot; id=&quot;postContext&quot;&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;div class=&quot;progress-container&quot;&gt;
  &lt;div class=&quot;progress&quot; id=&quot;progress&quot;&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
/* =========================
   STORAGE KEYS
========================= */
const STORAGE_TEXT = &quot;spritz_text&quot;;
const STORAGE_INDEX = &quot;spritz_index&quot;;
const STORAGE_WPM = &quot;spritz_wpm&quot;;

/* =========================
   DEFAULT TEXT
========================= */
const DEFAULT_TEXT = `Welcome to the Spritz-style speed reader.

Paste any text here — an article, a chapter, or an entire book.

Your reading position, speed, and text are saved automatically.
You can close the browser and resume exactly where you left off.

Tap once to start or pause.
Double tap to restart from the beginning.`;

/* =========================
   ELEMENTS
========================= */
const textInput = document.getElementById(&quot;textInput&quot;);
const wordEl = document.getElementById(&quot;word&quot;);
const preContextEl = document.getElementById(&quot;preContext&quot;);
const postContextEl = document.getElementById(&quot;postContext&quot;);
const progress = document.getElementById(&quot;progress&quot;);
const slider = document.getElementById(&quot;wpmSlider&quot;);
const wpmValue = document.getElementById(&quot;wpmValue&quot;);

/* =========================
   STATE
========================= */
let words = [];
let index = 0;
let timer = null;
let state = &quot;IDLE&quot;;
let lastTap = 0;
let wpm = 555;
let demoActive = false;

/* =========================
   INIT (RESTORE)
========================= */
const savedText = localStorage.getItem(STORAGE_TEXT);
const savedIndex = localStorage.getItem(STORAGE_INDEX);
const savedWpm = localStorage.getItem(STORAGE_WPM);

if (savedText) {
  textInput.value = savedText;
  index = savedIndex ? Number(savedIndex) : 0;
} else {
  textInput.value = DEFAULT_TEXT;
  demoActive = true;
}

if (savedWpm) wpm = Number(savedWpm);

slider.value = wpm;
wpmValue.textContent = wpm;

/* =========================
   TEXT INPUT HANDLING
========================= */
textInput.addEventListener(&quot;focus&quot;, () =&gt; {
  if (demoActive) {
    textInput.value = &quot;&quot;;
    demoActive = false;
  }
});

textInput.addEventListener(&quot;input&quot;, () =&gt; {
  localStorage.setItem(STORAGE_TEXT, textInput.value);
});

/* =========================
   WPM CONTROL
========================= */
slider.addEventListener(&quot;input&quot;, () =&gt; {
  wpm = Number(slider.value);
  wpmValue.textContent = wpm;
  localStorage.setItem(STORAGE_WPM, wpm);
});

/* =========================
   TEXT LOAD
========================= */
function loadText() {
  words = textInput.value.trim().split(/\s+/);
  progress.style.width = ((index + 1) / words.length) * 100 + &quot;%&quot;;
}

/* =========================
   ORP
========================= */
function getORPIndex(word) {
  if (word.length &lt;= 1) return 0;
  if (word.length &lt;= 5) return 1;
  if (word.length &lt;= 9) return 2;
  return 3;
}

function formatWord(word) {
  const i = getORPIndex(word);
  return `
    &lt;div class=&quot;word&quot;&gt;
      &lt;div class=&quot;left&quot;&gt;${word.slice(0, i)}&lt;/div&gt;
      &lt;div class=&quot;orp&quot;&gt;${word[i] || &quot;&quot;}&lt;/div&gt;
      &lt;div class=&quot;right&quot;&gt;${word.slice(i + 1)}&lt;/div&gt;
    &lt;/div&gt;
  `;
}

/* =========================
   CONTEXT WINDOW
========================= */
function updateContext() {
  const start = Math.max(0, index - 8);
  const end = Math.min(words.length, index + 8);

  preContextEl.textContent = words.slice(start, index).join(&quot; &quot;);
  postContextEl.textContent = words.slice(index + 1, end).join(&quot; &quot;);
}

/* =========================
   TIMING
========================= */
function getDelay(word) {
  let delay = 60000 / wpm;
  if (/[,.]/.test(word)) delay *= 1.5;
  if (/[!?]/.test(word)) delay *= 2;
  return delay;
}

/* =========================
   LOOP
========================= */
function tick() {
  if (index &gt;= words.length) {
    pause();
    return;
  }

  const current = words[index];
  wordEl.innerHTML = formatWord(current);
  preContextEl.textContent = &quot;&quot;;
  postContextEl.textContent = &quot;&quot;;

  progress.style.width = ((index + 1) / words.length) * 100 + &quot;%&quot;;
  localStorage.setItem(STORAGE_INDEX, index);

  index++;
  timer = setTimeout(tick, getDelay(current));
}

/* =========================
   CONTROLS
========================= */
function start() {
  if (state === &quot;IDLE&quot;) loadText();
  if (!words.length) return;

  state = &quot;RUNNING&quot;;
  tick();
}

function pause() {
  clearTimeout(timer);
  state = &quot;PAUSED&quot;;
  updateContext();
}

function restart() {
  clearTimeout(timer);
  index = 0;
  localStorage.setItem(STORAGE_INDEX, 0);
  loadText();
  state = &quot;IDLE&quot;;
  start();
}

/* =========================
   TAP HANDLING
========================= */
document.body.addEventListener(&quot;click&quot;, () =&gt; {
  const now = Date.now();

  if (now - lastTap &lt; 300) {
    restart();
  } else {
    state === &quot;RUNNING&quot; ? pause() : start();
  }

  lastTap = now;
});

/* =========================
   FULLSCREEN
========================= */
function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen();
  } else {
    document.exitFullscreen();
  }
}
&lt;/script&gt;

&lt;/body&gt;
&lt;/html&gt;


---

🧠 Why this is book-grade, not demo-grade

✔ Safe persistence (text + index + speed)

✔ Contextual pause without eye displacement

✔ Demo text never overwrites user data

✔ Restart logic deterministic

✔ Works for articles and novels

✔ Can resume after browser restart


This is now “read a book over days” ready.

