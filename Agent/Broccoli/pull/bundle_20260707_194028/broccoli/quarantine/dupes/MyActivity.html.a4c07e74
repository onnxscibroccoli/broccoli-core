<h3><strong>2. Scrappy Browser Dashboard Template</strong></h3>
<p>This standalone HTML/JavaScript file can be saved as <code>.html</code> and opened in any browser. It performs all calculations locally on the user&#39;s machine.</p>
<pre><code>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
    &lt;title&gt;2026 Live Arb Dashboard&lt;/title&gt;
    &lt;style&gt;
        body { font-family: monospace; background: #0b0e11; color: #eaecef; padding: 20px; }
        .row { display: flex; justify-content: space-around; margin-bottom: 20px; border-bottom: 1px solid #333; padding-bottom: 10px; }
        .price { font-size: 2em; font-weight: bold; }
        .gap { color: #02c076; font-size: 1.5em; }
        .negative { color: #cf304a; }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;h1&gt;Live BTC/USDT Arbitrage&lt;/h1&gt;
    &lt;div class=&quot;row&quot;&gt;
        &lt;div&gt;Binance: &lt;div id=&quot;binancePrice&quot; class=&quot;price&quot;&gt;--&lt;/div&gt;&lt;/div&gt;
        &lt;div&gt;Kraken: &lt;div id=&quot;krakenPrice&quot; class=&quot;price&quot;&gt;--&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;
    &lt;div style=&quot;text-align: center;&quot;&gt;
        &lt;div&gt;Calculated Gap:&lt;/div&gt;
        &lt;div id=&quot;gapValue&quot; class=&quot;gap&quot;&gt;0.00%&lt;/div&gt;
    &lt;/div&gt;

    &lt;script&gt;
        let binancePrice = 0, krakenPrice = 0;

        // 1. Connect to Binance WebSocket
        const bnWS = new WebSocket(&#39;wss://stream.binance.com:9443/ws/btcusdt@ticker&#39;);
        bnWS.onmessage = (event) =&gt; {
            const data = JSON.parse(event.data);
            binancePrice = parseFloat(data.c); // &#39;c&#39; is the last price
            document.getElementById(&#39;binancePrice&#39;).innerText = `$${binancePrice.toFixed(2)}`;
            calculateArb();
        };

        // 2. Connect to Kraken WebSocket
        const krWS = new WebSocket(&#39;wss://ws.kraken.com&#39;);
        krWS.onopen = () =&gt; {
            krWS.send(JSON.stringify({
                event: &quot;subscribe&quot;,
                pair: [&quot;BTC/USD&quot;],
                subscription: { name: &quot;ticker&quot; }
            }));
        };
        krWS.onmessage = (event) =&gt; {
            const data = JSON.parse(event.data);
            if (data &amp;&amp; data.c) { // &#39;c&#39; is the last price in Kraken v1
                krakenPrice = parseFloat(data.c);
                document.getElementById(&#39;krakenPrice&#39;).innerText = `$${krakenPrice.toFixed(2)}`;
                calculateArb();
            }
        };

        // 3. Local Logic Calculation
        function calculateArb() {
            if (binancePrice &amp;&amp; krakenPrice) {
                const diff = Math.abs(binancePrice - krakenPrice);
                const gap = (diff / Math.min(binancePrice, krakenPrice)) * 100;
                const gapEl = document.getElementById(&#39;gapValue&#39;);
                gapEl.innerText = `${gap.toFixed(4)}%`;
                
                // Visual Tuning: Highlights gaps larger than 0.1%
                gapEl.className = gap &gt; 0.1 ? &#39;gap&#39; : &#39;gap negative&#39;;
            }
        }
    &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
</code></pre>
