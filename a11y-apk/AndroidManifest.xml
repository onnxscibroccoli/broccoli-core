<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.broccoli.a11y">
  <application android:label="Broccoli A11y Helper" android:allowBackup="false">
    <service
        android:name=".BroccoliA11yService"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
        android:exported="true">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/a11y_service_config" />
    </service>
    <receiver android:name=".A11yCommandReceiver" android:exported="true">
      <intent-filter>
        <action android:name="com.broccoli.a11y.ACTION" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
