alse" selected="false" bounds="[32,2213][353,2253]" /><node index="5" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,2287][1048,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[64,2267][1016,2373]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[859,2267][1016,2373]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[859,2267][1016,2373]"><node index="0" text="Copy" resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[933,2315][995,2345]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[859,2298][1016,2362]" /></node></node></node><node index="1" text="" resource-id="" class="android.widget.HorizontalScrollView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[32,2373][1048,2408]"><node index="0" text="This chat → you paste Python once&#10;         → agent_loop → broccoli_agent.py → rish → Grok UI&#10;         → wire_context.json + ui_dump.xml (sync, before act)&#10;         → termux-clipboard-set + verify get&#10;         → tap composer (from XML) → paste → idle 3s → tap Send (from XML)&#10;Grok app ← message in thread (not “clipboard ghost”)" resource-id="" class="android.widget.TextView" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,2398][1048,2408]" /></node></node></node></node><node index="1" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,796][1080,943]"><node index="0" text="" resource-id="" class="android.widget.Button" package="ai.x.grok" content-desc="Scroll to bottom" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[922,796][1048,922]" /></node></node><node index="1" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,985][1080,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,985][1080,1417]" /><node index="1" text='Heck, yeah, let&apos;s test if it worked. It didn&apos;t , I had to do all of f*** y** it hits space this manually all it did was hitspace i guess you need a new here, doctor or something.I knew here doc a newexport PATH="$HOME/bin:$PATH" &amp;&amp; python3 &lt;&lt; &apos;PYEOF&apos;&#10;from pathlib import Path&#10;import stat, subprocess, textwrap&#10;&#10;B = Path.home() / "broccoli"&#10;for d in ("tools", "meta", "queue", "reports"):&#10;    (B / d).mkdir(parents=True, exist_ok=True)&#10;&#10;(B / "meta" / "wire_coords.env").write_text(textwrap.dedent("""\&#10;    COLLAB_POLL_SEC=0&#10;    GROK_PKG=com.ai.x.grok&#10;    TYPING_IDLE_SEC=3&#10;    ACT_ON_DUMP=1&#10;"""))&#10;&#10;agent_py = B / "tools" / "broccoli_agent.py"&#10;agent_py.write_text(textwrap.dedent(r&apos;&apos;&apos;&#10;#!/usr/bin/env python3&#10;"""Broccoli sync wire: rish + dump context → clipboard verify → paste → Send."""&#10;from __future__ import annotations&#10;import json, re, subprocess, sys, time&#10;from pathlib import Path&#10;from xml.etree import ElementTree as ET&#10;&#10;B = Path.home() / "broccoli"&#10;ENV = B / "meta" / "wire_coords.env"&#10;XML = B / "reports" / "ui_dump.xml"&#10;CTX = B / "reports" / "wire_context.json"&#10;LOG = B / "reports" / "agent_loop.log"&#10;&#10;def log(msg: str) -&gt; None:&#10;    LOG.parent.mkdir(parents=True, exist_ok=True)&#10;    with LOG.open("a") as f:&#10;        f.write(f"{time.strftime(&apos;%Y-%m-%dT%H:%M:%S&apos;)} {msg}\n")&#10;&#10;def load_env() -&gt; dict[str, str]:&#10;    out = {"GROK_PKG": "com.ai.x.grok", "TYPING_IDLE_SEC": "3"}&#10;    if ENV.is_file():&#10;        for line in ENV.read_text(errors="replace").splitlines():&#10;            line = line.strip()&#10;            if line and not line.startswith("#") and "=" in line:&#10;                k, v = line.split("=", 1)&#10;                out[k.strip()] = v.strip()&#10;    return out&#10;&#10;def rish(cmd: str, timeout: int = 45) -&gt; subprocess.CompletedProcess:&#10;    return subprocess.run(&#10;        ["rish", "-c", cmd],&#10;        capture_output=True,&#10;        text=True,&#10;        timeout=timeout,&#10;    )&#10;&#10;def sync_dump() -&gt; bool:&#10;    rish("uiautomator dump /data/local/tmp/broccoli_ui.xml")&#10;    r = rish("cat /data/local/tmp/broccoli_ui.xml")&#10;    if not r.stdout or len(r.stdout) &lt; 500:&#10;        r2 = subprocess.run(["brocc", "dump"], capture_output=True, text=True, timeout=60)&#10;        if r2.returncode == 0 and XML.is_file() and XML.stat().st_size &gt; 500:&#10;            return True&#10;        return False&#10;    XML.write_text(r.stdout, encoding="utf-8", errors="replace")&#10;    parse_context(XML)&#10;    return True&#10;&#10;def parse_context(xml_path: Path) -&gt; None:&#10;    raw = xml_path.read_text(errors="replace")&#10;    composer = send = None&#10;    pkg = ""&#10;    try:&#10;        root = ET.fromstring(raw)&#10;    except ET.ParseError:&#10;        CTX.write_text("{}")&#10;        return&#10;    def nums(s):&#10;        m = re.search(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", s or "")&#10;        return tuple(map(int, m.groups())) if m else None&#10;    def area(b):&#10;        return (b[2] - b[0]) * (b[3] - b[1]) if b else 0&#10;    for n in root.iter():&#10;        pkg = n.attrib.get("package") or pkg&#10;        cls = n.attrib.get("class") or ""&#10;        b = nums(n.attrib.get("bounds"))&#10;        if not b:&#10;            continue&#10;        if "EditText" in cls:&#10;            if composer is None or area(b) &gt; area(composer["bounds"]):&#10;                composer = {"text": n.attrib.get("text") or "", "bounds": list(b)}&#10;        label = (n.attrib.get("content-desc") or n.attrib.get("text") or "").strip()&#10;        if re.match(r"(?i)^(send|submit|go)$", label):&#10;            send = {"label": label, "bounds": list(b)}&#10;    CTX.write_text(json.dumps({"package": pkg, "composer": composer, "send": send}, indent=0))&#10;&#10;def center(bounds: list[int]) -&gt; tuple[int, int]:&#10;    return (bounds[0] + bounds[2]) // 2, (bounds[1] + bounds[3]) // 2&#10;&#10;def composer_text() -&gt; str:&#10;    if not CTX.is_file():&#10;        return ""&#10;    return (json.loads(CTX.read_text()).get("composer") or {}).get("text") or ""&#10;&#10;def wait_composer_idle(idle_sec: int) -&gt; bool:&#10;    stable = 0&#10;    while stable &lt; idle_sec:&#10;        if not sync_dump():&#10;            return False&#10;        t0 = composer_text()&#10;        time.sleep(1)&#10;        if not sync_dump():&#10;            return False&#10;        t1 = composer_text()&#10;        if t0 != t1:&#10;            stable = 0&#10;            log("WAIT typing_changed")&#10;        else:&#10;            stable += 1&#10;    log(f"OK composer_idle_{idle_sec}s")&#10;    return True&#10;&#10;def clipboard_set_verify(msg: str) -&gt; bool:&#10;    subprocess.run(["termux-clipboard-set", msg], check=False, capture_output=True)&#10;    time.sleep(0.2)&#10;    got = subprocess.run(["termux-clipboard-get"], capture_output=True, text=True)&#10;    g = (got.stdout or "").strip()&#10;    if msg[:32] != g[:32]:&#10;        subprocess.run(["sh", "-c", "termux-clipboard-set \"$1\"", "_", msg], check=False)&#10;        time.sleep(0.2)&#10;        got = subprocess.run(["termux-clipboard-get"], capture_output=True, text=True)&#10;        g = (got.stdout or "").strip()&#10;    if msg[:32] != g[:32]:&#10;        log(f"FAIL clipboard_mismatch want_len={len(msg)} got_len={len(g)}")&#10;        return False&#10;    log(f"OK clipboard_set len={len(msg)}")&#10;    return True&#10;&#10;def tap_bounds(kind: str) -&gt; bool:&#10;    data = json.loads(CTX.read_text())&#10;    node = data.get(kind)&#10;    if not node or not node.get("bounds"):&#10;        return False&#10;    x, y = center(node["bounds"])&#10;    rish(f"input tap {x} {y}")&#10;    return True&#10;&#10;def mark_in_xml(msg: str) -&gt; bool:&#10;    raw = XML.read_text(errors="replace") if XML.is_file() else ""&#10;    for m in (msg[:64], msg[:32], msg[:24]):&#10;        if m and m in raw:&#10;            return True&#10;    return False&#10;&#10;def wire_send(msg: str) -&gt; int:&#10;    cfg = load_env()&#10;    pkg = cfg.get("GROK_PKG", "com.ai.x.grok")&#10;    idle = int(cfg.get("TYPING_IDLE_SEC", "3"))&#10;    rish(f"am start -a android.intent.action.MAIN -c android.intent.category.LAUNCHER -p {pkg}")&#10;    time.sleep(0.45)&#10;    if not sync_dump():&#10;        log("FAIL dump_empty")&#10;        return 1&#10;    log(f"OK dump_sync bytes={XML.stat().st_size}")&#10;    if not wait_composer_idle(idle):&#10;        log("FAIL typing_not_idle")&#10;        return 1&#10;    if not clipboard_set_verify(msg):&#10;        return 1&#10;    if not tap_bounds("composer"):&#10;        log("FAIL no_composer_bounds")&#10;        return 1&#10;    time.sleep(0.2)&#10;    rish("input keyevent 279")&#10;    time.sleep(0.4)&#10;    if not sync_dump():&#10;        return 1&#10;    if not mark_in_xml(msg):&#10;        log("FAIL paste_not_in_dump")&#10;        return 1&#10;    log("OK paste_in_dump")&#10;    if tap_bounds("send"):&#10;        log("OK tap_send_xml")&#10;    else:&#10;        log("WARN no_send_bounds keyevent_enter")&#10;        rish("input keyevent 66")&#10;    time.sleep(0.5)&#10;    sync_dump()&#10;    log("OK wire_sync_done")&#10;    return 0&#10;&#10;def drain_queue() -&gt; None:&#10;    q = B / "queue" / "agent_task.txt"&#10;    if not q.is_file() or q.stat().st_size == 0:&#10;        return&#10;    msg = q.read_text(errors="replace")[:3800]&#10;    log(f"TRY queue_bytes={len(msg)}")&#10;    if wire_send(msg) == 0:&#10;        q.write_text("")&#10;        log("OK queue_cleared")&#10;    else:&#10;        log("RETRY keep_queue")&#10;&#10;def loop_forever() -&gt; None:&#10;    cfg = load_env()&#10;    poll = float(cfg.get("COLLAB_POLL_SEC", "0") or "0")&#10;    log("OK agent_started broccoli_agent.py")&#10;    while True:&#10;        drain_queue()&#10;        time.sleep(poll)&#10;&#10;if __name__ == "__main__":&#10;    if len(sys.argv) &gt; 1 and sys.argv[1] == "once":&#10;        drain_queue()&#10;        sys.exit(0)&#10;    if len(sys.argv) &gt; 2 and sys.argv[1] == "send":&#10;        sys.exit(wire_send(sys.argv[2]))&#10;    loop_forever()&#10;&apos;&apos;&apos;))&#10;agent_py.chmod(agent_py.stat().st_mode | stat.S_IXUSR)&#10;&#10;(B / "tools" / "agent_loop.sh").write_text(&#10;    "#!/data/data/com.termux/files/usr/bin/bash\n"&#10;    "export PATH=\"$HOME/bin:$PATH\"\n"&#10;    "exec python3 \"$HOME/broccoli/tools/broccoli_agent.py\"\n"&#10;)&#10;(B / "tools" / "agent_loop.sh").chmod(0o755)&#10;for name in ("collab_rish_loop.sh", "broccoli-daemon.sh"):&#10;    p = B / "tools" / name&#10;    p.write_text(&apos;#!/data/data/com.termux/files/usr/bin/bash\nexec bash "$HOME/broccoli/tools/agent_loop.sh"\n&apos;)&#10;    p.chmod(0o755)&#10;&#10;(B / "queue" / "agent_task.txt").write_text(&#10;    "BROCCOLI AGENT START — Reply BROCCOLI_LOOP_OK.\n"&#10;    "MISSION: (1) Sync wire confirmed: dump→context→clipboard verify→paste→Send from XML. "&#10;    "(2) consume_response patch plan. (3) Gemini/Workspace queries for RV3→V4.1 RWA blockchain spec.\n"&#10;    "INVARIANT: Human does not tap Send when idle ≥3s.\n"&#10;)&#10;&#10;subprocess.run("pkill -f broccoli_agent.py 2&gt;/dev/null; pkill -f agent_loop.sh 2&gt;/dev/null; sleep 0.5", shell=True)&#10;subprocess.run(&#10;    "nohup python3 ~/broccoli/tools/broccoli_agent.py &gt;&gt; ~/broccoli/reports/daemon.log 2&gt;&amp;1 &amp;",&#10;    shell=True,&#10;)&#10;print("INSTALLED: ~/broccoli/tools/broccoli_agent.py")&#10;print("STARTED: agent loop (broccoli_agent.py)")&#10;print("QUEUED: agent_task.txt — Grok Ask foreground, idle 3s, no manual Send")&#10;PYEOFhr &#10;A