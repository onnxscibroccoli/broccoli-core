[ -n "$INS" ] && echo "=== INSTRUCTIONS (head) ===" && sed -n '1,60p' "$INS"
[ -n "$TASK" ] && echo "=== TASK BOX ===" && cat "$TASK"
[ -f "$Q" ] && echo "=== QUEUE ===" && cat "$Q"
