[ -s "$BUNDLE" ] || bash "$HOME/broccoli/tools/prepare_mac_bundle.sh" >/dev/null
BODY="$(head -c 3500 "$BUNDLE")"
{
  echo ""
  echo "--- DEVICE_OUTPUT $(date -Iseconds) ---"
