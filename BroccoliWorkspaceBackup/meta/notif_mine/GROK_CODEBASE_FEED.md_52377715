if [ -x "$HOME/broccoli/tools/wire_send_ui.sh" ]; then
  REPLY="$(bash "$HOME/broccoli/tools/wire_send_ui.sh" "$MSG" 2>>"$LOG")" && { log "ok $REPLY"; echo "$REPLY"; exit 0; }
fi
log "fallback fail"
exit 1
