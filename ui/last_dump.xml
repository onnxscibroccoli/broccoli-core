ed="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2408]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[16,0][492,85]"><node index="0" text="" resource-id="" class="android.view.View" package="ai.x.grok" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[16,0][492,85]"><node index="0" text="" resource-id="" class="android.widget.ImageView" package="ai.x.grok" content-desc="Copy message" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1,0][127,101]" /><node index="1" text="" resource-id="" class="android.widget.ImageView" package="ai.x.grok" content-desc="Share this conversation" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[128,0][254,101]" /><node index="2" text="" resource-id="" class="android.widget.ImageView" package="ai.x.grok" content-desc="Like this response" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected